@ 混沌 64 位内核 —— 长模式里的第一口气

tt 主() -> u32 {
    印("\n")
    印("  混沌 HunDunOS  —  x86-64 长模式\n")
    印("  六爻源码 → 机器码，全程不经汇编器\n")
    印("  全程不经汇编器：as 与 ld 都没碰过这行字\n")
    印("\n")
    印("  数组和 = ")
    tz i: u32 = 0
    tz 和: u32 = 0
    ll i < 10 {
        和 = 和 + i * i
        i = i + 1
    }
    印(和)
    印("\n")
    zz 0
}
