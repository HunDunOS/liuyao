@ 六爻 64 位：函数、递归、循环、数组、字符串

qj 表[8]: u32

tt 阶乘(n: u32) -> u32 {
    lr n <= 1 {
        zz 1
    }
    zz n * 阶乘(n - 1)
}

tt 主() -> u32 {
    tz i: u32 = 0
    ll i < 8 {
        表[i] = i * 3 + 1
        i = i + 1
    }
    tz 和: u32 = 0
    i = 0
    ll i < 8 {
        和 = 和 + 表[i]
        i = i + 1
    }
    印("数组和 = ")
    印(和)
    印("\n")
    印("5 的阶乘 = ")
    印(阶乘(5))
    印("\n")
    zz 0
}
