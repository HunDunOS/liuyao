00 五行语言全指令测试脚本 v2
00 修正: tj语法是 tj 变量 值 (无等号)，变量只能存整数

jj "=== 五行全指令测试 v2 ==="
jj ""

jj "--- 1. jj 打印字符串 ---"
jj "PASS: jj打印字符串"

jj "--- 2. jj 打印数字 ---"
jj 42

jj "--- 3. tj 变量赋值 (tj x 100) ---"
tj x 100
jj x

jj "--- 4. tm 变量赋值(别名) ---"
tm y 200
jj y

jj "--- 5. mj 加等 ---"
tj a 5
mj a 3
jj a

jj "--- 6. mm 减等 ---"
tj b 10
mm b 4
jj b

jj "--- 7. ms 乘等 ---"
tj c 6
ms c 7
jj c

jj "--- 8. md 除等 ---"
tj d 20
md d 4
jj d

jj "--- 9. 表达式 ht/hz/hh/hl ---"
tj e 3
tj e2 4
tj e3 2
tj result e ht e2 hh e3
jj result

jj "--- 10. sj 相等比较 ---"
tj f 5
sj r f 5
jj r

jj "--- 11. sm 不等比较 ---"
sm r2 f 3
jj r2

jj "--- 12. ss 大于比较 ---"
ss r3 f 3
jj r3

jj "--- 13. sd 小于比较 ---"
sd r4 f 10
jj r4

jj "--- 14. st 大于等于 ---"
st r5 f 5
jj r5

jj "--- 15. sh 执行shell ---"
sh "echo PASS: shell命令执行成功"

jj "--- 16. Xj/Xt if条件 ---"
tj g 10
Xj g 5
jj "PASS: if条件为真(g>5)"
Xt

jj "--- 17. Xj/Xm/Xt if-else ---"
tj h 2
Xj h 5
jj "FAIL: 不应执行这里"
Xm h 1
jj "PASS: else-if条件为真(h>1)"
Xt

jj "--- 18. Cj/Cm/Cd/Ct for循环 (已知bug: 死循环，跳过) ---"
00 tj sum 0
00 Cj i 0
00 Cm i 5
00 mj sum 1
00 Cd i 1
00 Ct
00 jj sum
jj "SKIP: for循环当前死循环"

jj "--- 19. Dj break ---"
tj found 0
Cj j 0
Cm j 10
Xj j 3
tj found 1
Dj
Xt
Cd j 1
Ct
jj found

jj "--- 20. ds while循环 ---"
tj k 0
tj wsum 0
ds k 3
mj wsum k
mj k 1
jj wsum

jj "--- 21. ts/tt/dj 函数定义与调用 ---"
ts 测试函数()
jj "PASS: 函数被调用"
tt
dj 测试函数()

jj "--- 22. dm 函数返回 ---"
ts 返回测试()
dm 999
tt
dj 返回测试()

jj "--- 23. 注释 00 ---"
00 这行是注释不会执行
jj "PASS: 注释行被忽略"

jj ""
jj "=== 全部测试完成 ==="
jj "看到这行说明没有崩溃"
