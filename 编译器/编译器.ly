@ ══════════════════════════════════════════════════════════════════
@  词法.ly —— 用六爻写的词法分析器（自举第一级的第一块）
@
@  目标：对同一份源码，吐出和 stage0「lyc -词法」一模一样的记号流。
@        两边逐字节一致，才算这块写对了。
@
@  记号类别（和 stage0 的枚举一致）：
@     0 EOF   1 NL   2 NUM   3 STR   4 ID   5 KW   6 TY   7 P
@ ══════════════════════════════════════════════════════════════════

tl 记号 { 类: u32  值: u32  行: u32  文起: u32  文长: u32 }

qj 记号表[16384]: 记号
qj 记号数: u32

qj 文本池[65536]: u32         @ 记号的文字堆在这（按字节用，每个记号末尾补 0）
qj 池顶: u32
qj 池址: u32

qj 源址: u32                  @ 源码首址（按字节用）
qj 源长: u32
qj 位: u32                    @ 扫描位置
qj 行: u32

@ ── 关键字表：13 个 KEYWORDS + 3 个运算符关键字，都算 KW ──
qj 关字[24]: u32
qj 关字数: u32

@ ── 类型表：9 个 ──
qj 型字[48]: u32
qj 型字数: u32

@ ── 源码池：源码太大，一个字符串字面量塞不下，改成【分块拼进来】 ──
qj 源池[131072]: u32
qj 源池址: u32
qj 源池顶: u32

@ ── 数字字符（打印无符号数要用）──
qj 数字符[10]: u32
qj 数缓[16]: u32

@ ══════════════════════════════════════════════════════════════════
@  小工具
@ ══════════════════════════════════════════════════════════════════

@ 把一段（NUL 结尾的）源码拼进源池
tt 拼(s: *u8) -> u32 {
    tz i: u32 = 0
    ll {
        tz c: u32 = 0
        wx { c = ^(s + i) }
        lr c == 0 { ls }
        wx { ^(源池址 + 源池顶) = c }
        源池顶 = 源池顶 + 1
        i = i + 1
    }
    zz 0
}

@ 打印一个字符（借 数字符 表）
tt 打一位(d: u32) -> u32 {
    印串(数字符[d])
    zz 0
}

@ ★ 无符号打印：印() 是有符号的，值超过 2^31 会打成负数
tt 打无符号(v: u32) -> u32 {
    tz 值: u32 = 0
    tz n: u32 = 0
    tz i: u32 = 0
    值 = v                       @ 参数不可变，拷一份
    lr 值 == 0 { 打一位(0)  zz 0 }
    ll {
        lr 值 == 0 { ls }
        数缓[n] = 值 - (值  hl  10) * 10
        值 = 值  hl  10
        n = n + 1
    }
    i = n
    ll {
        lr i == 0 { ls }
        i = i - 1
        打一位(数缓[i])
    }
    zz 0
}

@ 取源码第 i 个字节
tt 取源(i: u32) -> u32 {
    tz c: u32 = 0
    wx { c = ^(源址 + i) }
    zz c
}

@ 往文本池塞一个字节，返回它的下标
tt 塞池(c: u32) -> u32 {
    tz k: u32 = 0
    wx { ^(池址 + 池顶) = c }
    k = 池顶
    池顶 = 池顶 + 1
    zz k
}

@ 文本池取字节
tt 取池(i: u32) -> u32 {
    tz c: u32 = 0
    wx { c = ^(池址 + i) }
    zz c
}

@ 把文本池里 [起,起+长) 和 NUL 结尾的字符串比较
tt 池比串(起: u32, 长: u32, s: *u8) -> u32 {
    tz i: u32 = 0
    ll {
        tz a: u32 = 0
        tz b: u32 = 0
        wx { b = ^(s + i) }
        lr i >= 长 {
            lr b != 0 { zz 0 }
            zz 1
        }
        a = 取池(起 + i)
        lr a != b { zz 0 }
        i = i + 1
    }
    zz 0
}

@ 是标识符字符吗（字母 / 下划线 / 高位字节）
tt 是名字(c: u32) -> u32 {
    lr c >= 97 { lr c <= 122 { zz 1 } }
    lr c >= 65 { lr c <= 90 { zz 1 } }
    lr c == 95 { zz 1 }
    lr c >= 128 { zz 1 }
    zz 0
}

@ 是数字字符吗
tt 是数字(c: u32) -> u32 {
    lr c >= 48 { lr c <= 57 { zz 1 } }
    zz 0
}

@ 十六进制一位的值；不是就返回 99
tt 十六值(c: u32) -> u32 {
    lr c >= 48 { lr c <= 57 { zz c - 48 } }
    lr c >= 97 { lr c <= 102 { zz c - 87 } }
    lr c >= 65 { lr c <= 70 { zz c - 55 } }
    zz 99
}

@ ══════════════════════════════════════════════════════════════════
@  敲一个记号进表
@ ══════════════════════════════════════════════════════════════════
tt 记(类: u32, 值: u32, 文起: u32, 文长: u32) -> u32 {
    lr 记号数 >= 16384 { zz 0 }
    记号表[记号数].类 = 类
    记号表[记号数].值 = 值
    记号表[记号数].行 = 行
    记号表[记号数].文起 = 文起
    记号表[记号数].文长 = 文长
    记号数 = 记号数 + 1
    zz 0
}

@ ══════════════════════════════════════════════════════════════════
@  主循环
@ ══════════════════════════════════════════════════════════════════
tt 词法() -> u32 {
    tz c: u32 = 0
    tz 起: u32 = 0
    tz 长: u32 = 0
    tz i: u32 = 0
    tz k: u32 = 0
    tz 找到: u32 = 0
    tz d: u32 = 0
    tz v: u32 = 0
    tz 值: u32 = 0
    tz 基: u32 = 0

    关字[0] = "tt"   关字[1] = "zz"   关字[2] = "th"   关字[3] = "tz"
    关字[4] = "nn"   关字[5] = "nr"   关字[6] = "nd"   关字[7] = "ns"
    关字[8] = "nf"   关字[9] = "tn"   关字[10] = "qj"  关字[11] = "wx"
    关字[12] = "hs"  关字[13] = "hr"  关字[14] = "hd"
    关字[15] = "ht"  关字[16] = "hz"  关字[17] = "hh"
    关字[18] = "hn"  关字[19] = "hf"
    关字[20] = "st"  关字[21] = "dt"  关字[22] = "dd"
    关字数 = 23
    型字[0] = "u8"   型字[1] = "u16"  型字[2] = "u32"
    型字[3] = "u64"  型字[4] = "i8"   型字[5] = "i16"
    型字[6] = "i32"  型字[7] = "i64"  型字[8] = "z"
    型字[9] = "J"
    型字[10] = "M"
    型字[11] = "S"
    型字[12] = "H"
    型字[13] = "T"
    型字[14] = "JJ"
    型字[15] = "JM"
    型字[16] = "JS"
    型字[17] = "JH"
    型字[18] = "JT"
    型字[19] = "MJ"
    型字[20] = "MM"
    型字[21] = "MS"
    型字[22] = "MH"
    型字[23] = "MT"
    型字[24] = "SJ"
    型字[25] = "SM"
    型字[26] = "SS"
    型字[27] = "SH"
    型字[28] = "ST"
    型字[29] = "HJ"
    型字[30] = "HM"
    型字[31] = "HS"
    型字[32] = "HH"
    型字[33] = "HT"
    型字[34] = "TJ"
    型字[35] = "TM"
    型字[36] = "TS"
    型字[37] = "TH"
    型字[38] = "TT"
    型字数 = 39

    wx { 池址 = 地址(文本池) }
    位 = 0
    行 = 1
    记号数 = 0
    池顶 = 0

    ll {
        lr 位 >= 源长 { ls }
        c = 取源(位)

        lr c == 32 { 位 = 位 + 1  lf }
        lr c == 9  { 位 = 位 + 1  lf }
        lr c == 13 { 位 = 位 + 1  lf }

        lr c == 10 {
            位 = 位 + 1
            记(1, 0, 0, 0)
            行 = 行 + 1
            lf
        }

        @ 分号也当语句结束（和 stage0 一致；注意它不加行号）
        lr c == 59 {
            位 = 位 + 1
            记(1, 0, 0, 0)
            lf
        }

        lr c == 64 {
            ll { lr 位 >= 源长 { ls }  lr 取源(位) == 10 { ls }  位 = 位 + 1 }
            lf
        }
        lr c == 35 {
            ll { lr 位 >= 源长 { ls }  lr 取源(位) == 10 { ls }  位 = 位 + 1 }
            lf
        }

        lr c == 34 {
            位 = 位 + 1
            起 = 池顶
            长 = 0
            ll {
                lr 位 >= 源长 { ls }
                d = 取源(位)
                lr d == 34 { 位 = 位 + 1  ls }
                lr d == 92 {
                    位 = 位 + 1
                    d = 取源(位)
                    lr d == 110 { d = 10 }
                    lr d == 116 { d = 9 }
                    lr d == 48  { d = 0 }
                    lr d == 101 { d = 27 }
                    lr d == 114 { d = 13 }
                    lr d == 98  { d = 8 }
                }
                塞池(d)
                长 = 长 + 1
                位 = 位 + 1
            }
            塞池(0)
            记(3, 0, 起, 长)
            lf
        }

        lr 是数字(c) {
            基 = 10
            lr c == 48 {
                lr 取源(位 + 1) == 120 { 基 = 16  位 = 位 + 2 }
                lr 取源(位 + 1) == 88  { 基 = 16  位 = 位 + 2 }
            }
            值 = 0
            ll {
                lr 位 >= 源长 { ls }
                d = 取源(位)
                v = 十六值(d)
                lr v > 15 { ls }
                lr 基 == 10 { lr v > 9 { ls } }
                值 = 值 * 基 + v
                位 = 位 + 1
            }
            记(2, 值, 0, 0)
            lf
        }

        @ ★ rd 山地 注释：行内注释到行尾
        lr 是名字(c) {
            起 = 池顶
            长 = 0
            ll {
                lr 位 >= 源长 { ls }
                d = 取源(位)
                lr 是名字(d) { 塞池(d)  长 = 长 + 1  位 = 位 + 1  lf }
                lr 是数字(d) { 塞池(d)  长 = 长 + 1  位 = 位 + 1  lf }
                ls
            }
            塞池(0)
            lr 池比串(起, 长, "rd") == 1 {          @ rd = 行内注释，整行丢掉
                ll { lr 位 >= 源长 { ls }  lr 取源(位) == 10 { ls }  位 = 位 + 1 }
                lf
            }
            找到 = 0
            i = 0
            ll {
                lr i >= 关字数 { ls }
                lr 池比串(起, 长, 关字[i]) == 1 { 找到 = 1  ls }
                i = i + 1
            }
            lr 找到 == 1 { 记(5, 0, 起, 长)  lf }
            找到 = 0
            i = 0
            ll {
                lr i >= 型字数 { ls }
                lr 池比串(起, 长, 型字[i]) == 1 { 找到 = 1  ls }
                i = i + 1
            }
            lr 找到 == 1 { 记(6, 0, 起, 长)  lf }
            记(4, 0, 起, 长)
            lf
        }

        k = 0
        lr 位 + 1 < 源长 {
            d = 取源(位 + 1)
            lr c == 60  { lr d == 60  { k = 1 } }
            lr c == 62  { lr d == 62  { k = 1 } }
            lr c == 45  { lr d == 62  { k = 1 } }
            lr c == 61  { lr d == 61  { k = 1 } }
            lr c == 33  { lr d == 61  { k = 1 } }
            lr c == 60  { lr d == 61  { k = 1 } }
            lr c == 62  { lr d == 61  { k = 1 } }
            lr c == 38  { lr d == 38  { k = 1 } }
            lr c == 124 { lr d == 124 { k = 1 } }
        }
        lr k == 1 {
            起 = 池顶
            塞池(c)
            塞池(取源(位 + 1))
            塞池(0)
            记(7, 0, 起, 2)
            位 = 位 + 2
            lf
        }
        起 = 池顶
        塞池(c)
        塞池(0)
        记(7, 0, 起, 1)
        位 = 位 + 1
    }

    记(0, 0, 0, 0)
    zz 0
}

@ ══════════════════════════════════════════════════════════════════
@  NUL 结尾串的长度
@ ══════════════════════════════════════════════════════════════════
tt 串长(s: *u8) -> u32 {
    tz n: u32 = 0
    ll {
        tz c: u32 = 0
        wx { c = ^(s + n) }
        lr c == 0 { ls }
        n = n + 1
    }
    zz n
}

@ ══════════════════════════════════════════════════════════════════
@  导出记号流（格式和 stage0 的 -词法 一样）
@ ══════════════════════════════════════════════════════════════════
tt 打印文本(起: u32, 长: u32) -> u32 {
    @ 文本池里每个记号后面都补了 0，所以直接把指针交给 印串
    印串(池址 + 起)
    zz 0
}

tt 导出() -> u32 {
    tz i: u32 = 0
    tz 类: u32 = 0
    tz j: u32 = 0
    ll {
        lr i >= 记号数 { ls }
        类 = 记号表[i].类
        印(记号表[i].行)
        印(" ")
        lr 类 == 0 { 印("EOF ") 印("\n") }
        lr 类 == 1 { 印("NL ")  印("\n") 印("\n") }
        lr 类 == 2 { 印("NUM ") 打无符号(记号表[i].值) 印("\n") }
        lr 类 == 3 {
            j = 0
            印("STR ")
            打无符号(记号表[i].文长)
            ll {
                lr j >= 记号表[i].文长 { ls }
                印(" ")
                打无符号(取池(记号表[i].文起 + j))
                j = j + 1
            }
            印("\n")
        }
        lr 类 == 4 { 印("ID ") 打印文本(记号表[i].文起, 记号表[i].文长) 印("\n") }
        lr 类 == 5 { 印("KW ") 打印文本(记号表[i].文起, 记号表[i].文长) 印("\n") }
        lr 类 == 6 { 印("TY ") 打印文本(记号表[i].文起, 记号表[i].文长) 印("\n") }
        lr 类 == 7 { 印("P ")  打印文本(记号表[i].文起, 记号表[i].文长) 印("\n") }
        i = i + 1
    }
    zz 0
}

tt 数字符初始化() -> u32 {
    数字符[0] = "0"  数字符[1] = "1"  数字符[2] = "2"  数字符[3] = "3"
    数字符[4] = "4"  数字符[5] = "5"  数字符[6] = "6"  数字符[7] = "7"
    数字符[8] = "8"  数字符[9] = "9"
    zz 0
}

tt 装源池() -> u32 {
    wx { ^(源池址 + 源池顶) = 0 }
    源址 = 源池址
    源长 = 源池顶
    zz 0
}

tt 分析源池() -> u32 {
    装源池()
    词法()
    导出()
    zz 记号数
}

tt 只词法() -> u32 {
    装源池()
    词法()
    zz 记号数
}

tt 分析(s: *u8) -> u32 {
    源址 = 0
    wx { 源址 = s }
    源长 = 串长(s)
    词法()
    导出()
    zz 记号数
}
@ ══════════════════════════════════════════════════════════════════
@  语法.ly —— 用六爻写的「签名扫描器」（自举第一级的第二块）
@
@  只扫【顶层声明】，不建完整语法树：
@     tn 名 { 字段: 类型 … }         → 结构体
@     qj 名[个数]: 类型             → 全局
@     tt 名(参数: 类型 …) -> 类型    → 函数（函数体整块跳过）
@
@  产出和 stage0「lyc -符号」一模一样的符号表，逐行比。
@
@  依赖：必须先有 词法.ly（记号表 / 文本池 / 池址 都在那）
@ ══════════════════════════════════════════════════════════════════

tl 函数记 { 名起: u32  名长: u32  参起: u32  参个数: u32  返回: u32  体起: u32  体止: u32 }
tl 名记   { 名起: u32  名长: u32  尺寸: u32  个数: u32  偏移: u32  构: u32 }
tl 构记   { 名起: u32  名长: u32  尺寸: u32  字段数: u32  字起: u32 }

qj 函表[512]: 函数记
qj 函数: u32
qj 参表[2048]: 名记
qj 参数: u32
qj 构表[64]: 构记
qj 构数: u32
qj 字表[1024]: 名记
qj 字数: u32
qj 全表[512]: 名记
qj 全数: u32

qj 游标: u32

@ ── 类型尺寸 ──
tt 型尺寸(k: u32) -> u32 {
    @ 型字：0..8 u8..z  |  9..13 J M S H T  |  14..38 五行配对
    tz r: u32 = 4
    lr k == 0 { r = 1 }
    lr k == 4 { r = 1 }
    lr k == 8 { r = 1 }
    lr k == 1 { r = 2 }
    lr k == 5 { r = 2 }
    lr k == 10 { r = 8 }      @ M 木 = 指针
    lr k == 11 { r = 1 }      @ S 水 = 字节
    lr k == 19 { r = 8 }
    lr k == 20 { r = 8 }
    lr k == 21 { r = 8 }
    lr k == 22 { r = 8 }
    lr k == 23 { r = 8 }
    lr k == 24 { r = 1 }
    lr k == 25 { r = 1 }
    lr k == 26 { r = 1 }
    lr k == 27 { r = 1 }
    lr k == 28 { r = 1 }
    zz r
}

@ 从 型字 表里找类型名，返回下标；找不到返回 99
tt 找类型(i: u32) -> u32 {
    tz k: u32 = 0
    ll {
        lr k >= 型字数 { ls }
        lr 池比串(记号表[i].文起, 记号表[i].文长, 型字[k]) == 1 { zz k }
        k = k + 1
    }
    zz 99
}

@ 结构体名 → 下标；找不到 99
tt 找结构(i: u32) -> u32 {
    tz k: u32 = 0
    ll {
        lr k >= 构数 { ls }
        lr 池比串(记号表[i].文起, 记号表[i].文长, 池址 + 构表[k].名起) == 1 { zz k }
        k = k + 1
    }
    zz 99
}

@ 跳过一对花括号（游标停在 } 之后）
tt 跳块() -> u32 {
    tz 深: u32 = 0
    ll {
        lr 游标 >= 记号数 { ls }
        tz c: u32 = 0
        c = 记号表[游标].类
        lr c == 7 {
            lr 池比串(记号表[游标].文起, 记号表[游标].文长, "{") == 1 { 深 = 深 + 1 }
            lr 池比串(记号表[游标].文起, 记号表[游标].文长, "}") == 1 {
                深 = 深 - 1
                lr 深 == 0 { 游标 = 游标 + 1  zz 0 }
            }
        }
        游标 = 游标 + 1
    }
    zz 0
}

@ 现在是某个符号吗
tt 是符(i: u32, s: *u8) -> u32 {
    lr 记号表[i].类 != 7 { zz 0 }
    zz 池比串(记号表[i].文起, 记号表[i].文长, s)
}

@ 现在是某个关键字吗
tt 是关(i: u32, s: *u8) -> u32 {
    lr 记号表[i].类 != 5 { zz 0 }
    zz 池比串(记号表[i].文起, 记号表[i].文长, s)
}

@ ══════════════════════════════════════════════════════════════════
@  扫一遍顶层
@ ══════════════════════════════════════════════════════════════════
tt 扫() -> u32 {
    tz i: u32 = 0
    tz sz: u32 = 0
    tz 个: u32 = 0
    tz 指: u32 = 0
    tz 字段: u32 = 0
    tz 表始: u32 = 0
    tz 构: u32 = 0
    tz 是基: u32 = 0

    游标 = 0
    ll {
        lr 游标 >= 记号数 { ls }
        lr 记号表[游标].类 == 1 { 游标 = 游标 + 1  lf }      @ 换行
        lr 记号表[游标].类 == 0 { ls }                        @ EOF

        @ ── 结构体 tn ──
        lr 是关(游标, "tn") == 1 {
            游标 = 游标 + 1
            sz = 0
            字段 = 0
            表始 = 字数
            lr 构数 < 64 {
                构表[构数].名起 = 记号表[游标].文起
                构表[构数].名长 = 记号表[游标].文长
                构表[构数].字段数 = 0
                构表[构数].字起 = 表始
            }
            游标 = 游标 + 1                       @ 跳结构体名
            lr 是符(游标, "{") == 1 {
                游标 = 游标 + 1
                ll {
                    lr 记号表[游标].类 == 0 { ls }
                    lr 是符(游标, "}") == 1 { 游标 = 游标 + 1  ls }
                    lr 记号表[游标].类 == 4 {
                        字表[字数].名起 = 记号表[游标].文起
                        字表[字数].名长 = 记号表[游标].文长
                        字表[字数].尺寸 = 4
                        字表[字数].偏移 = sz            @ ★ 字段偏移 = 累加到现在的大小
                        字数 = 字数 + 1
                        字段 = 字段 + 1
                        游标 = 游标 + 1
                        lr 是符(游标, ":") == 1 {
                            游标 = 游标 + 1
                            是基 = 0
                            lr 记号表[游标].类 == 6 {
                                是基 = 1
                                sz = sz + 型尺寸(找类型(游标))
                                字表[字数 - 1].尺寸 = 型尺寸(找类型(游标))
                                游标 = 游标 + 1
                            }
                            @ ★ 只有没吃到基本类型时，才把 ID 当结构体名（否则会吃掉下一个字段名）
                            lr 是基 == 0 { lr 记号表[游标].类 == 4 { 游标 = 游标 + 1 } }
                        }
                        lf
                    }
                    游标 = 游标 + 1
                }
            }
            lr 构数 < 64 {
                构表[构数].尺寸 = sz
                构表[构数].字段数 = 字段
                构数 = 构数 + 1
            }
            lf
        }

        @ ── 全局 qj ──
        lr 是关(游标, "qj") == 1 {
            游标 = 游标 + 1
            sz = 4
            个 = 1
            lr 全数 < 512 {
                全表[全数].名起 = 记号表[游标].文起
                全表[全数].名长 = 记号表[游标].文长
            }
            游标 = 游标 + 1
            lr 是符(游标, "[") == 1 {             @ 数组
                游标 = 游标 + 1
                个 = 记号表[游标].值
                游标 = 游标 + 1
                lr 是符(游标, "]") == 1 { 游标 = 游标 + 1 }
            }
            lr 是符(游标, ":") == 1 {
                游标 = 游标 + 1
                lr 是符(游标, "*") == 1 { sz = 8  游标 = 游标 + 1 指 = 1 }
                lr 指 == 0 {
                    lr 记号表[游标].类 == 6 { sz = 型尺寸(找类型(游标))  游标 = 游标 + 1 }
                    lr 记号表[游标].类 == 4 {                @ 结构体名 → 取结构体大小
                        构 = 找结构(游标)
                        lr 构 < 99 {
                            sz = 构表[构].尺寸
                            全表[全数].构 = 构
                        }
                        游标 = 游标 + 1
                    }
                }
                指 = 0
            }
            lr 全数 < 512 {
                全表[全数].尺寸 = sz
                全表[全数].个数 = 个
                全数 = 全数 + 1
            }
            lf
        }

        @ ── 函数 tt ──
        lr 是关(游标, "tt") == 1 {
            游标 = 游标 + 1
            lr 函数 < 512 {
                函表[函数].名起 = 记号表[游标].文起
                函表[函数].名长 = 记号表[游标].文长
                函表[函数].参起 = 参数
                函表[函数].参个数 = 0
                函表[函数].返回 = 4
                函表[函数].体起 = 0
                函表[函数].体止 = 0
            }
            游标 = 游标 + 1
            lr 是符(游标, "(") == 1 {
                游标 = 游标 + 1
                ll {
                    lr 记号表[游标].类 == 0 { ls }
                    lr 是符(游标, ")") == 1 { 游标 = 游标 + 1  ls }
                    lr 记号表[游标].类 == 4 {
                        参表[参数].名起 = 记号表[游标].文起
                        参表[参数].名长 = 记号表[游标].文长
                        参表[参数].尺寸 = 4
                        参表[参数].个数 = 0
                        参表[参数].构 = 99
                        参数 = 参数 + 1
                        游标 = 游标 + 1
                        lr 是符(游标, ":") == 1 {
                            游标 = 游标 + 1
                            lr 是符(游标, "*") == 1 {
                                参表[参数 - 1].尺寸 = 8
                                参表[参数 - 1].个数 = 1
                                游标 = 游标 + 1
                                lr 记号表[游标].类 == 6 { 游标 = 游标 + 1 }
                            }
                            lr 记号表[游标].类 == 6 {
                                参表[参数 - 1].尺寸 = 型尺寸(找类型(游标))
                                游标 = 游标 + 1
                            }
                            lr 记号表[游标].类 == 4 { 游标 = 游标 + 1 }
                        }
                        lf
                    }
                    游标 = 游标 + 1
                }
            }
            sz = 4                               @ ★ 先归位：没写 -> 类型 时默认 4
            lr 是符(游标, "->") == 1 {
                游标 = 游标 + 1
                lr 记号表[游标].类 == 6 { sz = 型尺寸(找类型(游标))  游标 = 游标 + 1 }
            }
            lr 函数 < 512 {
                函表[函数].参个数 = 参数 - 函表[函数].参起
                函表[函数].返回 = sz
                函数 = 函数 + 1
            }
            lr 是符(游标, "{") == 1 {
                lr 函数 > 0 { 函表[函数 - 1].体起 = 游标 + 1 }   @ ★ 计数已经 +1 了，要退一格
                跳块()
                lr 函数 > 0 { 函表[函数 - 1].体止 = 游标 - 1 }
            }
            lf
        }

        游标 = 游标 + 1
    }
    zz 0
}

@ ══════════════════════════════════════════════════════════════════
@  导出（格式和 stage0 -符号 一样）
@ ══════════════════════════════════════════════════════════════════
tt 出符号() -> u32 {
    tz i: u32 = 0
    tz j: u32 = 0
    i = 0
    ll {
        lr i >= 构数 { ls }
        印("结构体 ")
        印串(池址 + 构表[i].名起)
        印(" ")
        打无符号(构表[i].尺寸)
        印(" ")
        打无符号(构表[i].字段数)
        印("\n")
        j = 0
        ll {
            lr j >= 构表[i].字段数 { ls }
            印("字段 ")
            印串(池址 + 字表[构表[i].字起 + j].名起)
            印(" ")
            打无符号(字表[构表[i].字起 + j].尺寸)
            印("\n")
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    ll {
        lr i >= 全数 { ls }
        印("全局 ")
        印串(池址 + 全表[i].名起)
        印(" ")
        打无符号(全表[i].尺寸)
        印(" ")
        打无符号(全表[i].个数)
        印("\n")
        i = i + 1
    }
    i = 0
    ll {
        lr i >= 函数 { ls }
        印("函数 ")
        印串(池址 + 函表[i].名起)
        印(" ")
        打无符号(函表[i].参个数)
        印(" ")
        打无符号(函表[i].返回)
        印("\n")
        j = 0
        ll {
            lr j >= 函表[i].参个数 { ls }
            印("参数 ")
            印串(池址 + 参表[函表[i].参起 + j].名起)
            印(" ")
            打无符号(参表[函表[i].参起 + j].尺寸)
            印(" ")
            打无符号(参表[函表[i].参起 + j].个数)
            印("\n")
            j = j + 1
        }
        i = i + 1
    }
    zz 0
}
@ ══════════════════════════════════════════════════════════════════
@  出码.ly —— 用六爻写的出码器（自举第一级的第三块 / M3）
@
@  目标：对同一份源码，吐出和 stage0 一模一样的 .s，逐字节比。
@
@  M3 是最大的一块，先做【能对上第一小步】：
@     · 文件头
@     · 一个无参函数：开帧 / 局部变量 / 取值 / 返回 / 收帧
@     · 全局变量 → .comm
@
@  依赖：词法.ly（记号表 / 文本池）+ 语法.ly（符号表）
@ ══════════════════════════════════════════════════════════════════

tl 局记 { 名起: u32  名长: u32  偏移: u32  尺寸: u32  个数: u32  指针: u32  正: u32  构: u32 }
qj 局表[128]: 局记
qj 局数: u32
qj 帧大: u32

@ ── 出码全程要用的（必须声明在函数之前）──
qj 当前函数: u32
qj 字符串表[512]: u32
qj 字符数: u32
qj 标号号: u32
qj 环顶[16]: u32
qj 环底[16]: u32
qj 环数: u32
qj 有条件: u32
qj 是串: u32
qj 出宽: u32
qj 内建名[48]: u32
qj 内建符[48]: u32
qj 内建数: u32

@ ── 单字符打印（要造 1 字节的临时串给 印串）──
qj 字符缓[4]: u32
qj 字符址: u32

tt 印单(c: u32) -> u32 {
    wx {
        ^(字符址 + 0) = c
        ^(字符址 + 1) = 0
    }
    印串(字符址)
    zz 0
}

@ ── 十六进制两位 ──
qj 十六符[16]: u32

tt 十六初始化() -> u32 {
    十六符[0] = "0"   十六符[1] = "1"   十六符[2] = "2"   十六符[3] = "3"
    十六符[4] = "4"   十六符[5] = "5"   十六符[6] = "6"   十六符[7] = "7"
    十六符[8] = "8"   十六符[9] = "9"   十六符[10] = "a"  十六符[11] = "b"
    十六符[12] = "c"  十六符[13] = "d"  十六符[14] = "e"  十六符[15] = "f"
    zz 0
}

tt 打十六(c: u32) -> u32 {
    印串(十六符[(c  hl  16) - ((c  hl  16)  hl  16) * 16])
    印串(十六符[c - (c  hl  16) * 16])
    zz 0
}

@ ── 名字拼音化（和 stage0 的 mangle 一致）──
tt 是名字符(c: u32) -> u32 {
    lr c >= 97  { lr c <= 122 { zz 1 } }
    lr c >= 65  { lr c <= 90  { zz 1 } }
    lr c >= 48  { lr c <= 57  { zz 1 } }
    lr c == 95  { zz 1 }
    zz 0
}

tt 打拼音(起: u32, 长: u32) -> u32 {
    tz k: u32 = 0
    tz c: u32 = 0
    ll {
        lr k >= 长 { ls }
        c = 取池(起 + k)
        lr 是名字符(c) == 1 { 印单(c) }
        lr 是名字符(c) == 0 {
            印单(95)
            打十六(c)
        }
        k = k + 1
    }
    zz 0
}

@ ── 输出辅助 ──
tt 行(s: *u8) -> u32 {
    @ 打 "\t" + s + "\n"
    tz a: u32 = 0
    印("\t")
    印串(s)
    印("\n")
    zz 0
}

tt 行无(s: *u8) -> u32 {
    印串(s)
    印("\n")
    zz 0
}

@ ══════════════════════════════════════════════════════════════════
@  出码：文件头
@ ══════════════════════════════════════════════════════════════════
tt 出头() -> u32 {
    印("# 由 六爻(liuyao) 编译器 lyc 生成\n")
    行(".intel_syntax noprefix")
    印("\n")
    行(".section .text")
    zz 0
}

@ ══════════════════════════════════════════════════════════════════
@  出码：全局 → .comm
@ ══════════════════════════════════════════════════════════════════
tt 出全局() -> u32 {
    tz i: u32 = 0
    tz 尺: u32 = 0
    lr 全数 == 0 { zz 0 }
    印("\n")
    行(".section .bss")
    行(".align 4")
    i = 0
    ll {
        lr i >= 全数 { ls }
        印("\t.comm g_")
        打拼音(全表[i].名起, 全表[i].名长)
        印(", ")
        尺 = 全表[i].尺寸
        lr 尺 < 4 { 尺 = 4 }        @ ★ stage0 里全局强制至少 4 字节
        打无符号(尺 * 全表[i].个数)
        印(", 4\n")
        i = i + 1
    }
    zz 0
}

@ ══════════════════════════════════════════════════════════════════
@  表达式出码（和 stage0 的 expr / unary / primary 一一对应）
@ ══════════════════════════════════════════════════════════════════
tt 是文(i: u32, s: *u8) -> u32 {
    zz 池比串(记号表[i].文起, 记号表[i].文长, s)
}

@ 运算符优先级（和 stage0 的 prec_of 一致）
tt 优先级(i: u32) -> u32 {
    tz r: u32 = 0
    lr 标记号(i) == 0 { zz 0 }
    lr 是文(i, "hr") == 1 { r = 3 }
    lr 是文(i, "hd") == 1 { r = 4 }
    lr 是文(i, "hs") == 1 { r = 5 }
    lr 是文(i, "==") == 1 { r = 6 }
    lr 是文(i, "!=") == 1 { r = 6 }
    lr 是文(i, "<")  == 1 { r = 7 }
    lr 是文(i, "<=") == 1 { r = 7 }
    lr 是文(i, ">")  == 1 { r = 7 }
    lr 是文(i, ">=") == 1 { r = 7 }
    lr 是文(i, "<<") == 1 { r = 8 }
    lr 是文(i, ">>") == 1 { r = 8 }
    lr 是文(i, "+")  == 1 { r = 9 }
    lr 是文(i, "-")  == 1 { r = 9 }
    lr 是文(i, "ht") == 1 { r = 9 }
    lr 是文(i, "hz") == 1 { r = 9 }
    lr 是文(i, "*")  == 1 { r = 10 }
    lr 是文(i, "/")  == 1 { r = 10 }
    lr 是文(i, "%")  == 1 { r = 10 }
    lr 是文(i, "hh") == 1 { r = 10 }
    lr 是文(i, "hn") == 1 { r = 10 }
    lr 是文(i, "hf") == 1 { r = 10 }
    zz r
}

@ 只认符号和运算关键字
tt 标记号(i: u32) -> u32 {
    lr 记号表[i].类 == 7 { zz 1 }
    lr 记号表[i].类 == 5 { zz 1 }
    zz 0
}

tt 出二元(i: u32) -> u32 {
    行("mov rcx, rax")
    行("pop rax")
    lr 是文(i, "+")  == 1 { 行("add rax, rcx") }
    lr 是文(i, "ht") == 1 { 行("add rax, rcx") }
    lr 是文(i, "-")  == 1 { 行("sub rax, rcx") }
    lr 是文(i, "hz") == 1 { 行("sub rax, rcx") }
    lr 是文(i, "*")  == 1 { 行("imul rax, rcx") }
    lr 是文(i, "hh") == 1 { 行("imul rax, rcx") }
    lr 是文(i, "hs") == 1 { 行("and rax, rcx") }
    lr 是文(i, "hr") == 1 { 行("or rax, rcx") }
    lr 是文(i, "hd") == 1 { 行("xor rax, rcx") }
    lr 是文(i, "<<") == 1 { 行("shl rax, cl") }
    lr 是文(i, ">>") == 1 { 行("shr rax, cl") }
    lr 是文(i, "/")  == 1 { 行("xor rdx, rdx")  行("div rcx") }
    lr 是文(i, "hn") == 1 { 行("xor rdx, rdx")  行("div rcx") }
    lr 是文(i, "%")  == 1 { 行("xor rdx, rdx")  行("div rcx")  行("mov rax, rdx") }
    lr 是文(i, "hf") == 1 { 行("xor rdx, rdx")  行("div rcx")  行("mov rax, rdx") }
    lr 是文(i, "==") == 1 { 出比较("e") }
    lr 是文(i, "!=") == 1 { 出比较("ne") }
    lr 是文(i, "<")  == 1 { 出比较("l") }
    lr 是文(i, "<=") == 1 { 出比较("le") }
    lr 是文(i, ">")  == 1 { 出比较("g") }
    lr 是文(i, ">=") == 1 { 出比较("ge") }
    zz 0
}

tt 出比较(cc: *u8) -> u32 {
    行("cmp rax, rcx")
    印("\tset")
    印串(cc)
    印(" al\n")
    行("movzx rax, al")
    zz 0
}

