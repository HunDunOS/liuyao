tt 找内建(起: u32, 长: u32) -> u32 {
    tz k: u32 = 0
    ll {
        lr k >= 内建数 { ls }
        lr 池比串(起, 长, 内建名[k]) == 1 { zz k }
        k = k + 1
    }
    zz 99
}

@ 函数调用：名 ( 参, 参 … )
tt 出调用() -> u32 {
    tz n: u32 = 0
    tz k: u32 = 0
    tz 名起: u32 = 0
    tz 名长: u32 = 0
    名起 = 记号表[游标].文起
    名长 = 记号表[游标].文长
    游标 = 游标 + 2
    lr 是符(游标, ")") == 0 {
        ll {
            出表达式(0)
            行("push rax")
            n = n + 1
            lr 是符(游标, ",") == 0 { ls }
            游标 = 游标 + 1
        }
    }
    游标 = 游标 + 1
    k = 找内建(名起, 名长)
    lr k < 99 {
        印("\tcall ")
        印串(内建符[k])
        印("\n")
    }
    lr k == 99 {
        印("\tcall fn_")
        打拼音(名起, 名长)
        印("\n")
    }
    lr n > 0 {
        印("\tadd rsp, ")
        打无符号(n * 8)
        印("\n")
    }
    zz 0
}

tt 出基本() -> u32 {
    tz q: u32 = 99
    tz 宽: u32 = 4
    tz 下标过: u32 = 0
    @ 括号：原样解析里面的表达式
    lr 是符(游标, "(") == 1 {
        游标 = 游标 + 1
        出表达式(0)
        吃符(")")
        zz 0
    }
    tz j: u32 = 0
    tz k: u32 = 0
    tz 值: u32 = 0
    tz 名起: u32 = 0
    tz 名长: u32 = 0
    lr 记号表[游标].类 == 2 {
        值 = 记号表[游标].值
        印("\tmov rax, ")
        打无符号(值)
        印("\n")
        游标 = 游标 + 1
        zz 0
    }
    @ 字符串字面量当值 → 登记进字符串表，取它的地址
    lr 记号表[游标].类 == 3 {
        字符串表[字符数] = 游标
        印("\tmov rax, offset .Lstr")
        打无符号(字符数)
        印("\n")
        字符数 = 字符数 + 1
        游标 = 游标 + 1
        zz 0
    }
    lr 记号表[游标].类 == 4 {
        @ ★ 地址(名) 必须排在【函数调用】之前，不然会被当调用
        lr 池比串(记号表[游标].文起, 记号表[游标].文长, "地址") == 1 {
            lr 记号表[游标 + 1].类 == 7 {
                lr 是符(游标 + 1, "(") == 1 {
                    tz 甲: u32 = 0
                    tz 乙: u32 = 0
                    tz jj: u32 = 0
                    tz kk: u32 = 0
                    甲 = 记号表[游标 + 2].文起
                    乙 = 记号表[游标 + 2].文长
                    jj = 找局部(甲, 乙)
                    lr jj < 99 { 出基址2(0, 甲, 乙, 局表[jj].偏移, 局表[jj].正) }
                    lr jj == 99 {
                        kk = 找全局(甲, 乙)
                        lr kk < 99 { 出基址2(1, 全表[kk].名起, 全表[kk].名长, 0, 0) }
                    }
                    游标 = 游标 + 4
                    zz 0
                }
            }
        }
        lr 记号表[游标 + 1].类 == 7 {
            lr 是符(游标 + 1, "(") == 1 { 出调用()  zz 0 }
        }
        名起 = 记号表[游标].文起
        名长 = 记号表[游标].文长
        j = 找局部(名起, 名长)
        lr j < 99 {
            出基址2(0, 名起, 名长, 局表[j].偏移, 局表[j].正)
            游标 = 游标 + 1
            lr 是符(游标, "[") == 1 {
                出下标2(名起, 名长, 0, 局表[j].偏移, 局表[j].尺寸, 局表[j].个数, 局表[j].指针, 局表[j].正)
                出取值(局表[j].尺寸)
                zz 0
            }
            lr 局表[j].个数 == 1 { 出取值(局表[j].尺寸) }   @ 纯数组名 = 地址
            zz 0
        }
        k = 找全局(名起, 名长)
        lr k < 99 {
            出基址(1, 全表[k].名起, 全表[k].名长, 0)
            游标 = 游标 + 1
            宽 = 全表[k].尺寸
            lr 是符(游标, "[") == 1 {
                出下标(全表[k].名起, 全表[k].名长, 1, 0, 全表[k].尺寸, 全表[k].个数, 0)
                宽 = 全表[k].尺寸
                下标过 = 1
            }
            lr 是符(游标, ".") == 1 {
                游标 = 游标 + 1
                tz fj2: u32 = 0
                fj2 = 找字段(全表[k].构, 记号表[游标].文起, 记号表[游标].文长)
                lr fj2 < 99 {
                    lr 字表[构表[全表[k].构].字起 + fj2].偏移 != 0 {
                        印("\tadd rax, ")
                        打无符号(字表[构表[全表[k].构].字起 + fj2].偏移)
                        印("\n")
                    }
                    宽 = 字表[构表[全表[k].构].字起 + fj2].尺寸
                    游标 = 游标 + 1
                }
                出取值(宽)
                zz 0
            }
            lr 下标过 == 1 { 出取值(宽)  zz 0 }
            lr 全表[k].个数 == 1 { 出取值(宽) }
            zz 0
        }
        游标 = 游标 + 1
        zz 0
    }
    zz 0
}

tt 出一元() -> u32 {
    lr 是符(游标, "-") == 1 {
        游标 = 游标 + 1
        出一元()
        行("neg rax")
        zz 0
    }
    lr 是符(游标, "^") == 1 {
        游标 = 游标 + 1
        出一元()
        行("movzx rax, byte ptr [rax]")
        zz 0
    }
    lr 是符(游标, "!") == 1 {
        游标 = 游标 + 1
        出一元()
        行("test rax, rax")
        行("sete al")
        行("movzx rax, al")
        zz 0
    }
    出基本()
    zz 0
}

tt 跳行(止: u32) -> u32 {
    ll {
        lr 游标 >= 止 { ls }
        lr 记号表[游标].类 == 1 { ls }
        lr 记号表[游标].类 == 0 { ls }
        lr 是符(游标, "}") == 1 { ls }     @ ★ 同一行上的 } 也要停下
        游标 = 游标 + 1
    }
    zz 0
}

tt 出表达式(最小: u32) -> u32 {
    tz p: u32 = 0
    tz oi: u32 = 0
    出一元()
    ll {
        oi = 游标
        p = 优先级(oi)
        lr p == 0 { ls }
        lr p < 最小 { ls }
        游标 = 游标 + 1
        行("push rax")
        出表达式(p + 1)
        出二元(oi)
    }
    zz 0
}

@ ══════════════════════════════════════════════════════════════════
@  局部变量表（每个函数重算）
@ ══════════════════════════════════════════════════════════════════
@ 名字是不是这个
tt 名同(起: u32, 长: u32, j: u32) -> u32 {
    lr 长 != 局表[j].名长 { zz 0 }
    zz 池比串(局表[j].名起, 局表[j].名长, 池址 + 起)
}

@ 找局部；找不到 99
tt 找局部(起: u32, 长: u32) -> u32 {
    tz j: u32 = 0
    ll {
        lr j >= 局数 { ls }
        lr 名同(起, 长, j) == 1 { zz j }
        j = j + 1
    }
    zz 99
}

@ 预扫函数体：给每个 tz/th 分配槽位（8 字节一个），算出帧大小
tt 预扫(k: u32) -> u32 {
    tz 止: u32 = 0
    局数 = 0
    帧大 = 0
    止 = 函表[k].体止
    游标 = 函表[k].体起
    ll {
        lr 游标 >= 止 { ls }
        lr 是关(游标, "tz") == 1 { 收局部() }
        lr 是关(游标, "th") == 1 { 收局部() }
        游标 = 游标 + 1
    }
    收参数(k)
    帧大 = ((帧大 + 15)  hl  16) * 16        @ 对齐 16（SysV：call 时 rsp 必须 16 对齐）
    zz 0
}

@ 参数在 [rbp+16+8i]（调用者压的），偏移从 +16 起、步长 8
tt 收参数(k: u32) -> u32 {
    tz i: u32 = 0
    tz n: u32 = 0
    n = 函表[k].参个数
    i = 0
    ll {
        lr i >= n { ls }
        lr 局数 < 128 {
            局表[局数].名起 = 参表[函表[k].参起 + i].名起
            局表[局数].名长 = 参表[函表[k].参起 + i].名长
            局表[局数].偏移 = 16 + 8 * (n - 1 - i)
            局表[局数].尺寸 = 4        @ ★ stage0 里参数尺寸一律 4（连指针参数也是）
            局表[局数].个数 = 1
            局表[局数].指针 = 参表[函表[k].参起 + i].个数
            局表[局数].正 = 1
            局表[局数].构 = 参表[函表[k].参起 + i].构
            局数 = 局数 + 1
        }
        i = i + 1
    }
    zz 0
}

tt 收局部() -> u32 {
    lr 记号表[游标 + 1].类 == 4 {
        lr 局数 < 128 {
            tz 尺寸: u32 = 4
            tz 个数: u32 = 1
            tz 指针: u32 = 0
            tz q: u32 = 0
            q = 游标 + 2
            lr 是符(q, "[") == 1 {
                个数 = 记号表[q + 1].值
                q = q + 3
            }
            lr 是符(q, ":") == 1 {
                q = q + 1
                lr 是符(q, "*") == 1 { 尺寸 = 8  指针 = 1  q = q + 2 }
                lr 指针 == 0 {
                    lr 记号表[q].类 == 6 { 尺寸 = 型尺寸(找类型(q))  q = q + 1 }
                    lr 记号表[q].类 == 4 { 尺寸 = 4  q = q + 1 }
                }
            }
            局表[局数].名起 = 记号表[游标 + 1].文起
            局表[局数].名长 = 记号表[游标 + 1].文长
            帧大 = 帧大 + 8 * 个数
            局表[局数].偏移 = 帧大
            局表[局数].尺寸 = 尺寸
            局表[局数].个数 = 个数
            局表[局数].指针 = 指针
            局表[局数].正 = 0
            局表[局数].构 = 99
            lr 记号表[q].类 == 4 {
                tz sj: u32 = 0
                sj = 找结构(q)
                lr sj < 99 { 局表[局数].构 = sj }
            }
            局数 = 局数 + 1
        }
    }
    zz 0
}

tt 找全局(起: u32, 长: u32) -> u32 {
    tz k: u32 = 0
    ll {
        lr k >= 全数 { ls }
        lr 池比串(全表[k].名起, 全表[k].名长, 池址 + 起) == 1 { zz k }
        k = k + 1
    }
    zz 99
}

@ 基址 → rax
@ 在结构体 si 里找字段；返回字段下标，找不到 99
tt 找字段(si: u32, 起: u32, 长: u32) -> u32 {
    tz j: u32 = 0
    lr si >= 99 { zz 99 }
    ll {
        lr j >= 构表[si].字段数 { ls }
        lr 池比串(字表[构表[si].字起 + j].名起, 字表[构表[si].字起 + j].名长, 池址 + 起) == 1 { zz j }
        j = j + 1
    }
    zz 99
}

tt 出基址(是全局: u32, 名起: u32, 名长: u32, 偏移: u32) -> u32 {
    zz 出基址2(是全局, 名起, 名长, 偏移, 0)
}

tt 出基址2(是全局: u32, 名起: u32, 名长: u32, 偏移: u32, 正: u32) -> u32 {
    lr 是全局 == 0 {
        印("\tlea rax, [rbp")
        lr 正 == 1 { 印("+") }
        lr 正 == 0 { 印("-") }
        打无符号(偏移)
        印("]\n")
    }
    lr 是全局 == 1 {
        印("\tmov rax, offset g_")
        打拼音(名起, 名长)
        印("\n")
    }
    zz 0
}

@ 下标：rax 里已有基址，消耗 [ 下标 ]
tt 出下标(基起: u32, 基长: u32, 是全局: u32, 偏移: u32, 元素: u32, 个数: u32, 指针: u32) -> u32 {
    zz 出下标2(基起, 基长, 是全局, 偏移, 元素, 个数, 指针, 0)
}

tt 出下标2(基起: u32, 基长: u32, 是全局: u32, 偏移: u32, 元素: u32, 个数: u32, 指针: u32, 正: u32) -> u32 {
    tz lok: u32 = 0
    游标 = 游标 + 1                       @ 跳过 [
    出表达式(0)                           @ rax = 下标
    吃符("]")
    lr 指针 == 0 {
        lr 个数 > 1 {                     @ 定长数组：越界检查
            印("\tcmp rax, ")
            打无符号(个数)
            印("\n")
            lok = 新标号()
            印("\tjb .Lbok")
            打无符号(lok)
            印("\n")
            行("call _rt_oob")
            标行("bok", lok)
        }
    }
    lr 元素 > 1 {
        印("\timul rax, ")
        打无符号(元素)
        印("\n")
    }
    行("push rax")
    出基址2(是全局, 基起, 基长, 偏移, 正)
    行("mov rcx, rax")
    行("pop rax")
    行("add rax, rcx")
    zz 0
}

@ 按宽度取值
tt 出字段址(si: u32) -> u32 {
    lr 是符(游标, ".") == 1 {
        游标 = 游标 + 1
        tz fj: u32 = 0
        fj = 找字段(si, 记号表[游标].文起, 记号表[游标].文长)
        lr fj < 99 {
            lr 字表[构表[si].字起 + fj].偏移 != 0 {
                印("\tadd rax, ")
                打无符号(字表[构表[si].字起 + fj].偏移)
                印("\n")
            }
            出宽 = 字表[构表[si].字起 + fj].尺寸
            游标 = 游标 + 1
        }
    }
    zz 0
}

tt 出赋值(宽: u32) -> u32 {
    lr 是符(游标, "=") == 1 {
        游标 = 游标 + 1
        行("push rax")
        出表达式(0)
        行("mov rcx, rax")
        行("pop rax")
        lr 宽 == 1 { 行("mov byte ptr [rax], cl") }
        lr 宽 == 2 { 行("mov word ptr [rax], cx") }
        lr 宽 == 8 { 行("mov [rax], rcx") }
        lr 宽 == 4 { 行("mov [rax], ecx") }
    }
    zz 0
}

tt 出取值(宽: u32) -> u32 {
    lr 宽 == 1 { 行("movzx rax, byte ptr [rax]") }
    lr 宽 == 2 { 行("movzx rax, word ptr [rax]") }
    lr 宽 == 8 { 行("mov rax, [rax]") }
    lr 宽 == 4 { 行("mov eax, [rax]") }
    zz 0
}

@ ══════════════════════════════════════════════════════════════════
@  出码：一个函数
@ ══════════════════════════════════════════════════════════════════
@ ══════════════════════════════════════════════════════════════════
@  控制流（和 stage0 的 stmt 一一对应，连标号编号顺序都要一样）
@ ══════════════════════════════════════════════════════════════════
qj 调: u32

tt 新标号() -> u32 {
    标号号 = 标号号 + 1
    zz 标号号
}

tt 印标(p: *u8, n: u32) -> u32 {
    印(".L")
    印串(p)
    打无符号(n)
    zz 0
}

tt 标行(p: *u8, n: u32) -> u32 {
    印标(p, n)
    印(":\n")
    zz 0
}

tt 跳空() -> u32 {
    ll {
        lr 记号表[游标].类 == 1 { 游标 = 游标 + 1  lf }
        ls
    }
    zz 0
}

tt 吃符(s: *u8) -> u32 {
    lr 是符(游标, s) == 1 { 游标 = 游标 + 1 }
    跳空()
    zz 0
}

tt 体(止: u32) -> u32 {
    tz 前: u32 = 0
    ll {
        跳空()                       @ ★ 先跳过换行，不然停在换行上就看不到 }
        lr 游标 >= 止 { ls }
        lr 记号表[游标].类 == 0 { ls }
        lr 是符(游标, "}") == 1 { ls }
        前 = 游标
        出语句(止)
        lr 游标 == 前 {              @ ★ 护栏：游标没动就是卡住了，报出来别空转
            印("[卡住！第 ")
            打无符号(游标)
            印(" 号记号：")
            印串(池址 + 记号表[游标].文起)
            印("]\n")
            ls
        }
    }
    zz 0
}

tt 出语句(止: u32) -> u32 {
    tz 标A: u32 = 0
    tz 标B: u32 = 0
    tz j: u32 = 0
    tz k: u32 = 0
    tz p: u32 = 0
    tz 名起: u32 = 0
    tz 名长: u32 = 0
    tz 宽: u32 = 0

    跳空()
    lr 游标 >= 止 { zz 0 }
    lr 记号表[游标].类 == 0 { zz 0 }

    @ ── 印 / 印串 ──
    lr 记号表[游标].类 == 4 {
        lr 池比串(记号表[游标].文起, 记号表[游标].文长, "印") == 1 {
            lr 记号表[游标 + 1].类 == 7 {
                lr 是符(游标 + 1, "(") == 1 {
                    游标 = 游标 + 2
                    是串 = 0
                    lr 记号表[游标].类 == 3 { 是串 = 1 }
                    lr 是串 == 1 {
                        字符串表[字符数] = 游标
                        印("\tpush offset .Lstr")
                        打无符号(字符数)
                        印("\n")
                        字符数 = 字符数 + 1
                        游标 = 游标 + 1
                        行("call _rt_puts")
                        行("add rsp, 8")
                    }
                    lr 是串 == 0 {
                        出表达式(0)
                        行("push rax")
                        行("call _rt_puti")
                        行("add rsp, 8")
                    }
                    吃符(")")
                    zz 0
                }
            }
        }
        lr 池比串(记号表[游标].文起, 记号表[游标].文长, "印串") == 1 {
            lr 记号表[游标 + 1].类 == 7 {
                lr 是符(游标 + 1, "(") == 1 {
                    游标 = 游标 + 2
                    出表达式(0)
                    行("push rax")
                    行("call _rt_puts")
                    行("add rsp, 8")
                    吃符(")")
                    zz 0
                }
            }
        }
    }

    @ ── st dt 值（写整数） / st dd 串（写字符串）──
    lr 是关(游标, "st") == 1 {
        游标 = 游标 + 1
        lr 是关(游标, "dt") == 1 {
            游标 = 游标 + 1
            出表达式(0)
            行("push rax")
            行("call _rt_puti")
            行("add rsp, 8")
            zz 0
        }
        lr 是关(游标, "dd") == 1 {
            游标 = 游标 + 1
            是串 = 0
            lr 记号表[游标].类 == 3 { 是串 = 1 }
            lr 是串 == 1 {
                字符串表[字符数] = 游标
                印("\tpush offset .Lstr")
                打无符号(字符数)
                印("\n")
                字符数 = 字符数 + 1
                游标 = 游标 + 1
            }
            lr 是串 == 0 {
                出表达式(0)
                行("push rax")
            }
            行("call _rt_puts")
            行("add rsp, 8")
            zz 0
        }
        zz 0
    }

    @ ── 解引用写：^地址 = 值（按字节）──
    lr 是符(游标, "^") == 1 {
        游标 = 游标 + 1
        出一元()
        lr 是符(游标, "=") == 1 { 游标 = 游标 + 1 }
        行("push rax")
        出表达式(0)
        行("mov rcx, rax")
        行("pop rax")
        行("mov byte ptr [rax], cl")
        zz 0
    }

    @ ── wx 危险块（只是放开权限，本身不出码）──
    lr 是关(游标, "wx") == 1 {
        游标 = 游标 + 1
        吃符("{")
        体(止)
        吃符("}")
        zz 0
    }

    @ ── nr 条件 { } [nd { }] ──
    lr 是关(游标, "nr") == 1 {
        游标 = 游标 + 1
        出表达式(0)
        行("test rax, rax")
        标A = 新标号()
        印("\tjz .Lelse")
        打无符号(标A)
        印("\n")
        吃符("{")
        体(止)
        吃符("}")
        lr 是关(游标, "nd") == 1 {
            标B = 新标号()
            印("\tjmp .Lendif")
            打无符号(标B)
            印("\n")
            标行("else", 标A)
            游标 = 游标 + 1
            吃符("{")
            体(止)
            吃符("}")
            标行("endif", 标B)
            zz 0
        }
        标行("else", 标A)
        zz 0
    }

    @ ── nn [条件] { } ──
    lr 是关(游标, "nn") == 1 {
        游标 = 游标 + 1
        跳空()
        lr 是符(游标, "{") == 1 {
            标A = 新标号()
            标B = 新标号()
            印标("ltop", 标A)
            印(":\n")
        }
        lr 是符(游标, "{") == 0 {
            标A = 新标号()
            标B = 新标号()
            印标("wtop", 标A)
            印(":\n")
        }
        环顶[环数] = 标A
        环底[环数] = 标B
        lr 环数 < 15 { 环数 = 环数 + 1 }
        有条件 = 0
        lr 是符(游标, "{") == 0 {
            有条件 = 1
            出表达式(0)
            行("test rax, rax")
            印("\tjz ")
            印标("wend", 标B)
            印("\n")
        }
        吃符("{")
        体(止)
        吃符("}")
        环数 = 环数 - 1
        印("\tjmp ")
        lr 有条件 == 1 { 印标("wtop", 标A) }
        lr 有条件 == 0 { 印标("ltop", 标A) }
        印("\n")
        lr 有条件 == 1 { 标行("wend", 标B) }
        lr 有条件 == 0 { 标行("lend", 标B) }
        zz 0
    }

    @ ── ns 跳出 / nf 继续 ──
    lr 是关(游标, "ns") == 1 {
        游标 = 游标 + 1
        印("\tjmp ")
        印标("lend", 环底[环数 - 1])
        印("\n")
        跳行(止)
        zz 0
    }
    lr 是关(游标, "nf") == 1 {
        游标 = 游标 + 1
        印("\tjmp ")
        印标("ltop", 环顶[环数 - 1])
        印("\n")
        跳行(止)
        zz 0
    }

    @ ── tz 名 [ … ] : 类型 [ = 初值 ] ──
    lr 是关(游标, "tz") == 1 {
        j = 找局部(记号表[游标 + 1].文起, 记号表[游标 + 1].文长)
        p = 游标 + 2
        ll {
            lr 记号表[p].类 == 0 { ls }
            lr 记号表[p].类 == 1 { ls }
            lr 是符(p, "=") == 1 { ls }
            p = p + 1
        }
        lr j < 99 {
            lr 记号表[p].类 == 7 {
                游标 = p + 1
                出表达式(0)
            }
            lr 记号表[p].类 != 7 { 游标 = p }      @ 没初值：游标推到行尾
            印("\tmov [rbp-")
            打无符号(局表[j].偏移)
            印("], rax\n")
        }
        跳行(止)
        zz 0
    }

    @ ── zz 表达式 ──
    lr 是关(游标, "zz") == 1 {
        游标 = 游标 + 1
        出表达式(0)
        印("\tjmp .Lret_")
        打拼音(函表[当前函数].名起, 函表[当前函数].名长)
        印("\n")
        跳行(止)
        zz 0
    }

    @ ── 名字[下标][.字段] = 值   /   名字.字段 = 值 ──
    lr 记号表[游标].类 == 4 {
        lr 是符(游标 + 1, "[") == 1 {
            名起 = 记号表[游标].文起
            名长 = 记号表[游标].文长
            j = 找局部(名起, 名长)
            lr j < 99 {
                出基址2(0, 名起, 名长, 局表[j].偏移, 局表[j].正)
                游标 = 游标 + 1
                出下标2(名起, 名长, 0, 局表[j].偏移, 局表[j].尺寸, 局表[j].个数, 局表[j].指针, 局表[j].正)
                出宽 = 局表[j].尺寸
                出字段址(局表[j].构)
                出赋值(出宽)
                zz 0
            }
            k = 找全局(名起, 名长)
            lr k < 99 {
                出基址(1, 全表[k].名起, 全表[k].名长, 0)
                游标 = 游标 + 1
                出下标(全表[k].名起, 全表[k].名长, 1, 0, 全表[k].尺寸, 全表[k].个数, 0)
                出宽 = 全表[k].尺寸
                出字段址(全表[k].构)
                出赋值(出宽)
                zz 0
            }
        }
        lr 是符(游标 + 1, ".") == 1 {
            lr 记号表[游标 + 2].类 == 4 {
                名起 = 记号表[游标].文起
                名长 = 记号表[游标].文长
                j = 找局部(名起, 名长)
                lr j < 99 {
                    出基址2(0, 名起, 名长, 局表[j].偏移, 局表[j].正)
                    游标 = 游标 + 1
                    出宽 = 局表[j].尺寸
                    出字段址(局表[j].构)
                    出赋值(出宽)
                    zz 0
                }
                k = 找全局(名起, 名长)
                lr k < 99 {
                    出基址(1, 全表[k].名起, 全表[k].名长, 0)
                    游标 = 游标 + 1
                    出宽 = 全表[k].尺寸
                    出字段址(全表[k].构)
                    出赋值(出宽)
                    zz 0
                }
            }
        }
    }

    @ ── 名字 = 表达式（简单赋值：局部 / 全局）──
    lr 记号表[游标].类 == 4 {
        lr 是符(游标 + 1, "=") == 1 {
            名起 = 记号表[游标].文起
            名长 = 记号表[游标].文长
            j = 找局部(名起, 名长)
            lr j < 99 {
                游标 = 游标 + 2
                出表达式(0)
                印("\tmov [rbp")
                lr 局表[j].正 == 1 { 印("+") }
                lr 局表[j].正 == 0 { 印("-") }
                打无符号(局表[j].偏移)
                印("], rax\n")
                zz 0
            }
            k = 找全局(名起, 名长)
            lr k < 99 {
                游标 = 游标 + 2
                出表达式(0)
                宽 = 全表[k].尺寸
                lr 宽 == 1 { 印("\tmov byte ptr [g_") }
                lr 宽 == 2 { 印("\tmov word ptr [g_") }
                lr 宽 == 8 { 印("\tmov [g_") }
                lr 宽 == 4 { 印("\tmov dword ptr [g_") }
                打拼音(全表[k].名起, 全表[k].名长)
                印("], ")
                lr 宽 == 1 { 印("al\n") }
                lr 宽 == 2 { 印("ax\n") }
                lr 宽 == 8 { 印("rax\n") }
                lr 宽 == 4 { 印("eax\n") }
                zz 0
            }
            跳行(止)
            zz 0
        }
    }

    @ ── 兜底：表达式语句 ──
    出表达式(0)
    zz 0
}

tt 出函数(k: u32) -> u32 {
    tz 名起: u32 = 0
    tz 名长: u32 = 0
    tz j: u32 = 0
    tz p: u32 = 0
    名起 = 函表[k].名起
    名长 = 函表[k].名长

    预扫(k)
    游标 = 函表[k].体起                 @ ★ 必须在预扫之后 —— 预扫会把游标走到体止

    lr k > 0 { 印("\n") }
    印("\t.globl fn_")
    打拼音(名起, 名长)
    印("\nfn_")
    打拼音(名起, 名长)
    印(":\n")
    行("push rbp")
    行("mov rbp, rsp")
    lr 帧大 > 0 {
        印("\tsub rsp, ")
        打无符号(帧大)
        印("\n")
    }
    行("mov rax, 0")

    @ ── 体 ──
    环数 = 0
    体(函表[k].体止)

    印(".Lret_")
    打拼音(名起, 名长)
    印(":\n")
    行("mov rsp, rbp")
    行("pop rbp")
    行("ret")
    zz 0
}

tt 出字符串段() -> u32 {
    tz i: u32 = 0
    tz k: u32 = 0
    tz c: u32 = 0
    lr 字符数 == 0 { zz 0 }
    印("\n\t.section .rodata\n")
    i = 0
    ll {
        lr i >= 字符数 { ls }
        印(".Lstr")
        打无符号(i)
        印(":\n\t.asciz \"")
        k = 0
        ll {
            lr k >= 记号表[字符串表[i]].文长 { ls }
            c = 取池(记号表[字符串表[i]].文起 + k)
            lr c == 10 { 印("\\n") }
            lr c == 10 { }
            lr c == 9  { 印("\\t") }
            lr c == 34 { 印("\\\"") }
            lr c == 92 { 印("\\\\") }
            lr c != 10 {
                lr c != 9 {
                    lr c != 34 {
                        lr c != 92 { 印单(c) }
                    }
                }
            }
            k = k + 1
        }
        印("\"\n")
        i = i + 1
    }
    印("\t.section .text\n")
    zz 0
}

tt 出码() -> u32 {
    tz i: u32 = 0
    出头()
    内建初始化()
    字符数 = 0
    调 = 0
    标号号 = 0
    i = 0
    ll {
        lr i >= 函数 { ls }
        当前函数 = i
        出函数(i)
        i = i + 1
    }
    出全局()
    出字符串段()
    zz 0
}
