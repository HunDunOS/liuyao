@ ══════════════════════════════════════════════════════════════════
@  出码.ly —— 用六爻写的出码器（自举第一级的第三块 / M3）
@
@  目标：对同一份源码，吐出和 stage0 一模一样的 .s，逐字节比。
@
@  M3 是最大的一块，先做【能对上第一小步】：
@     · 文件头
@     · 一个无参函数：开帧 / 局部变量 / 取值 / 返回 / 收帧
@     · 全局变量 → .comm
@
@  依赖：词法.ly（记号表 / 文本池）+ 语法.ly（符号表）
@ ══════════════════════════════════════════════════════════════════

tl 局记 { 名起: u32  名长: u32  偏移: u32  尺寸: u32  个数: u32  指针: u32  正: u32  构: u32 }
qj 局表[128]: 局记
qj 局数: u32
qj 帧大: u32

@ ── 出码全程要用的（必须声明在函数之前）──
qj 当前函数: u32
qj 字符串表[512]: u32
qj 字符数: u32
qj 标号号: u32
qj 环顶[16]: u32
qj 环底[16]: u32
qj 环数: u32
qj 有条件: u32
qj 是串: u32
qj 出宽: u32
qj 内建名[48]: u32
qj 内建符[48]: u32
qj 内建数: u32

@ ── 单字符打印（要造 1 字节的临时串给 印串）──
qj 字符缓[4]: u32
qj 字符址: u32

tt 印单(c: u32) -> u32 {
    wx {
        ^(字符址 + 0) = c
        ^(字符址 + 1) = 0
    }
    印串(字符址)
    zz 0
}

@ ── 十六进制两位 ──
qj 十六符[16]: u32

tt 十六初始化() -> u32 {
    十六符[0] = "0"   十六符[1] = "1"   十六符[2] = "2"   十六符[3] = "3"
    十六符[4] = "4"   十六符[5] = "5"   十六符[6] = "6"   十六符[7] = "7"
    十六符[8] = "8"   十六符[9] = "9"   十六符[10] = "a"  十六符[11] = "b"
    十六符[12] = "c"  十六符[13] = "d"  十六符[14] = "e"  十六符[15] = "f"
    zz 0
}

tt 打十六(c: u32) -> u32 {
    印串(十六符[(c  hl  16) - ((c  hl  16)  hl  16) * 16])
    印串(十六符[c - (c  hl  16) * 16])
    zz 0
}

@ ── 名字拼音化（和 stage0 的 mangle 一致）──
tt 是名字符(c: u32) -> u32 {
    lr c >= 97  { lr c <= 122 { zz 1 } }
    lr c >= 65  { lr c <= 90  { zz 1 } }
    lr c >= 48  { lr c <= 57  { zz 1 } }
    lr c == 95  { zz 1 }
    zz 0
}

tt 打拼音(起: u32, 长: u32) -> u32 {
    tz k: u32 = 0
    tz c: u32 = 0
    ll {
        lr k >= 长 { ls }
        c = 取池(起 + k)
        lr 是名字符(c) == 1 { 印单(c) }
        lr 是名字符(c) == 0 {
            印单(95)
            打十六(c)
        }
        k = k + 1
    }
    zz 0
}

@ ── 输出辅助 ──
tt 行(s: *u8) -> u32 {
    @ 打 "\t" + s + "\n"
    tz a: u32 = 0
    印("\t")
    印串(s)
    印("\n")
    zz 0
}

tt 行无(s: *u8) -> u32 {
    印串(s)
    印("\n")
    zz 0
}

@ ══════════════════════════════════════════════════════════════════
@  出码：文件头
@ ══════════════════════════════════════════════════════════════════
tt 出头() -> u32 {
    印("# 由 六爻(liuyao) 编译器 lyc 生成\n")
    行(".intel_syntax noprefix")
    印("\n")
    行(".section .text")
    zz 0
}

@ ══════════════════════════════════════════════════════════════════
@  出码：全局 → .comm
@ ══════════════════════════════════════════════════════════════════
tt 出全局() -> u32 {
    tz i: u32 = 0
    tz 尺: u32 = 0
    lr 全数 == 0 { zz 0 }
    印("\n")
    行(".section .bss")
    行(".align 4")
    i = 0
    ll {
        lr i >= 全数 { ls }
        印("\t.comm g_")
        打拼音(全表[i].名起, 全表[i].名长)
        印(", ")
        尺 = 全表[i].尺寸
        lr 尺 < 4 { 尺 = 4 }        @ ★ stage0 里全局强制至少 4 字节
        打无符号(尺 * 全表[i].个数)
        印(", 4\n")
        i = i + 1
    }
    zz 0
}

@ ══════════════════════════════════════════════════════════════════
@  表达式出码（和 stage0 的 expr / unary / primary 一一对应）
@ ══════════════════════════════════════════════════════════════════
tt 是文(i: u32, s: *u8) -> u32 {
    zz 池比串(记号表[i].文起, 记号表[i].文长, s)
}

@ 运算符优先级（和 stage0 的 prec_of 一致）
tt 优先级(i: u32) -> u32 {
    tz r: u32 = 0
    lr 标记号(i) == 0 { zz 0 }
    lr 是文(i, "hr") == 1 { r = 3 }
    lr 是文(i, "hd") == 1 { r = 4 }
    lr 是文(i, "hs") == 1 { r = 5 }
    lr 是文(i, "==") == 1 { r = 6 }
    lr 是文(i, "!=") == 1 { r = 6 }
    lr 是文(i, "<")  == 1 { r = 7 }
    lr 是文(i, "<=") == 1 { r = 7 }
    lr 是文(i, ">")  == 1 { r = 7 }
    lr 是文(i, ">=") == 1 { r = 7 }
    lr 是文(i, "<<") == 1 { r = 8 }
    lr 是文(i, ">>") == 1 { r = 8 }
    lr 是文(i, "+")  == 1 { r = 9 }
    lr 是文(i, "-")  == 1 { r = 9 }
    lr 是文(i, "ht") == 1 { r = 9 }
    lr 是文(i, "hz") == 1 { r = 9 }
    lr 是文(i, "*")  == 1 { r = 10 }
    lr 是文(i, "/")  == 1 { r = 10 }
    lr 是文(i, "%")  == 1 { r = 10 }
    lr 是文(i, "hh") == 1 { r = 10 }
    lr 是文(i, "hn") == 1 { r = 10 }
    lr 是文(i, "hf") == 1 { r = 10 }
    zz r
}

@ 只认符号和运算关键字
tt 标记号(i: u32) -> u32 {
    lr 记号表[i].类 == 7 { zz 1 }
    lr 记号表[i].类 == 5 { zz 1 }
    zz 0
}

tt 出二元(i: u32) -> u32 {
    行("mov rcx, rax")
    行("pop rax")
    lr 是文(i, "+")  == 1 { 行("add rax, rcx") }
    lr 是文(i, "ht") == 1 { 行("add rax, rcx") }
    lr 是文(i, "-")  == 1 { 行("sub rax, rcx") }
    lr 是文(i, "hz") == 1 { 行("sub rax, rcx") }
    lr 是文(i, "*")  == 1 { 行("imul rax, rcx") }
    lr 是文(i, "hh") == 1 { 行("imul rax, rcx") }
    lr 是文(i, "hs") == 1 { 行("and rax, rcx") }
    lr 是文(i, "hr") == 1 { 行("or rax, rcx") }
    lr 是文(i, "hd") == 1 { 行("xor rax, rcx") }
    lr 是文(i, "<<") == 1 { 行("shl rax, cl") }
    lr 是文(i, ">>") == 1 { 行("shr rax, cl") }
    lr 是文(i, "/")  == 1 { 行("xor rdx, rdx")  行("div rcx") }
    lr 是文(i, "hn") == 1 { 行("xor rdx, rdx")  行("div rcx") }
    lr 是文(i, "%")  == 1 { 行("xor rdx, rdx")  行("div rcx")  行("mov rax, rdx") }
    lr 是文(i, "hf") == 1 { 行("xor rdx, rdx")  行("div rcx")  行("mov rax, rdx") }
    lr 是文(i, "==") == 1 { 出比较("e") }
    lr 是文(i, "!=") == 1 { 出比较("ne") }
    lr 是文(i, "<")  == 1 { 出比较("l") }
    lr 是文(i, "<=") == 1 { 出比较("le") }
    lr 是文(i, ">")  == 1 { 出比较("g") }
    lr 是文(i, ">=") == 1 { 出比较("ge") }
    zz 0
}

tt 出比较(cc: *u8) -> u32 {
    行("cmp rax, rcx")
    印("\tset")
    印串(cc)
    印(" al\n")
    行("movzx rax, al")
    zz 0
}

