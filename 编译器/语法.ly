@ ══════════════════════════════════════════════════════════════════
@  语法.ly —— 用六爻写的「签名扫描器」（自举第一级的第二块）
@
@  只扫【顶层声明】，不建完整语法树：
@     tn 名 { 字段: 类型 … }         → 结构体
@     qj 名[个数]: 类型             → 全局
@     tt 名(参数: 类型 …) -> 类型    → 函数（函数体整块跳过）
@
@  产出和 stage0「lyc -符号」一模一样的符号表，逐行比。
@
@  依赖：必须先有 词法.ly（记号表 / 文本池 / 池址 都在那）
@ ══════════════════════════════════════════════════════════════════

tl 函数记 { 名起: u32  名长: u32  参起: u32  参个数: u32  返回: u32  体起: u32  体止: u32 }
tl 名记   { 名起: u32  名长: u32  尺寸: u32  个数: u32  偏移: u32  构: u32 }
tl 构记   { 名起: u32  名长: u32  尺寸: u32  字段数: u32  字起: u32 }

qj 函表[512]: 函数记
qj 函数: u32
qj 参表[2048]: 名记
qj 参数: u32
qj 构表[64]: 构记
qj 构数: u32
qj 字表[1024]: 名记
qj 字数: u32
qj 全表[512]: 名记
qj 全数: u32

qj 游标: u32

@ ── 类型尺寸 ──
tt 型尺寸(k: u32) -> u32 {
    @ 型字：0..8 u8..z  |  9..13 J M S H T  |  14..38 五行配对
    tz r: u32 = 4
    lr k == 0 { r = 1 }
    lr k == 4 { r = 1 }
    lr k == 8 { r = 1 }
    lr k == 1 { r = 2 }
    lr k == 5 { r = 2 }
    lr k == 10 { r = 8 }      @ M 木 = 指针
    lr k == 11 { r = 1 }      @ S 水 = 字节
    lr k == 19 { r = 8 }
    lr k == 20 { r = 8 }
    lr k == 21 { r = 8 }
    lr k == 22 { r = 8 }
    lr k == 23 { r = 8 }
    lr k == 24 { r = 1 }
    lr k == 25 { r = 1 }
    lr k == 26 { r = 1 }
    lr k == 27 { r = 1 }
    lr k == 28 { r = 1 }
    zz r
}

@ 从 型字 表里找类型名，返回下标；找不到返回 99
tt 找类型(i: u32) -> u32 {
    tz k: u32 = 0
    ll {
        lr k >= 型字数 { ls }
        lr 池比串(记号表[i].文起, 记号表[i].文长, 型字[k]) == 1 { zz k }
        k = k + 1
    }
    zz 99
}

@ 结构体名 → 下标；找不到 99
tt 找结构(i: u32) -> u32 {
    tz k: u32 = 0
    ll {
        lr k >= 构数 { ls }
        lr 池比串(记号表[i].文起, 记号表[i].文长, 池址 + 构表[k].名起) == 1 { zz k }
        k = k + 1
    }
    zz 99
}

@ 跳过一对花括号（游标停在 } 之后）
tt 跳块() -> u32 {
    tz 深: u32 = 0
    ll {
        lr 游标 >= 记号数 { ls }
        tz c: u32 = 0
        c = 记号表[游标].类
        lr c == 7 {
            lr 池比串(记号表[游标].文起, 记号表[游标].文长, "{") == 1 { 深 = 深 + 1 }
            lr 池比串(记号表[游标].文起, 记号表[游标].文长, "}") == 1 {
                深 = 深 - 1
                lr 深 == 0 { 游标 = 游标 + 1  zz 0 }
            }
        }
        游标 = 游标 + 1
    }
    zz 0
}

@ 现在是某个符号吗
tt 是符(i: u32, s: *u8) -> u32 {
    lr 记号表[i].类 != 7 { zz 0 }
    zz 池比串(记号表[i].文起, 记号表[i].文长, s)
}

@ 现在是某个关键字吗
tt 是关(i: u32, s: *u8) -> u32 {
    lr 记号表[i].类 != 5 { zz 0 }
    zz 池比串(记号表[i].文起, 记号表[i].文长, s)
}

@ ══════════════════════════════════════════════════════════════════
@  扫一遍顶层
@ ══════════════════════════════════════════════════════════════════
tt 扫() -> u32 {
    tz i: u32 = 0
    tz sz: u32 = 0
    tz 个: u32 = 0
    tz 指: u32 = 0
    tz 字段: u32 = 0
    tz 表始: u32 = 0
    tz 构: u32 = 0
    tz 是基: u32 = 0

    游标 = 0
    ll {
        lr 游标 >= 记号数 { ls }
        lr 记号表[游标].类 == 1 { 游标 = 游标 + 1  lf }      @ 换行
        lr 记号表[游标].类 == 0 { ls }                        @ EOF

        @ ── 结构体 tn ──
        lr 是关(游标, "tn") == 1 {
            游标 = 游标 + 1
            sz = 0
            字段 = 0
            表始 = 字数
            lr 构数 < 64 {
                构表[构数].名起 = 记号表[游标].文起
                构表[构数].名长 = 记号表[游标].文长
                构表[构数].字段数 = 0
                构表[构数].字起 = 表始
            }
            游标 = 游标 + 1                       @ 跳结构体名
            lr 是符(游标, "{") == 1 {
                游标 = 游标 + 1
                ll {
                    lr 记号表[游标].类 == 0 { ls }
                    lr 是符(游标, "}") == 1 { 游标 = 游标 + 1  ls }
                    lr 记号表[游标].类 == 4 {
                        字表[字数].名起 = 记号表[游标].文起
                        字表[字数].名长 = 记号表[游标].文长
                        字表[字数].尺寸 = 4
                        字表[字数].偏移 = sz            @ ★ 字段偏移 = 累加到现在的大小
                        字数 = 字数 + 1
                        字段 = 字段 + 1
                        游标 = 游标 + 1
                        lr 是符(游标, ":") == 1 {
                            游标 = 游标 + 1
                            是基 = 0
                            lr 记号表[游标].类 == 6 {
                                是基 = 1
                                sz = sz + 型尺寸(找类型(游标))
                                字表[字数 - 1].尺寸 = 型尺寸(找类型(游标))
                                游标 = 游标 + 1
                            }
                            @ ★ 只有没吃到基本类型时，才把 ID 当结构体名（否则会吃掉下一个字段名）
                            lr 是基 == 0 { lr 记号表[游标].类 == 4 { 游标 = 游标 + 1 } }
                        }
                        lf
                    }
                    游标 = 游标 + 1
                }
            }
            lr 构数 < 64 {
                构表[构数].尺寸 = sz
                构表[构数].字段数 = 字段
                构数 = 构数 + 1
            }
            lf
        }

        @ ── 全局 qj ──
        lr 是关(游标, "qj") == 1 {
            游标 = 游标 + 1
            sz = 4
            个 = 1
            lr 全数 < 512 {
                全表[全数].名起 = 记号表[游标].文起
                全表[全数].名长 = 记号表[游标].文长
            }
            游标 = 游标 + 1
            lr 是符(游标, "[") == 1 {             @ 数组
                游标 = 游标 + 1
                个 = 记号表[游标].值
                游标 = 游标 + 1
                lr 是符(游标, "]") == 1 { 游标 = 游标 + 1 }
            }
            lr 是符(游标, ":") == 1 {
                游标 = 游标 + 1
                lr 是符(游标, "*") == 1 { sz = 8  游标 = 游标 + 1 指 = 1 }
                lr 指 == 0 {
                    lr 记号表[游标].类 == 6 { sz = 型尺寸(找类型(游标))  游标 = 游标 + 1 }
                    lr 记号表[游标].类 == 4 {                @ 结构体名 → 取结构体大小
                        构 = 找结构(游标)
                        lr 构 < 99 {
                            sz = 构表[构].尺寸
                            全表[全数].构 = 构
                        }
                        游标 = 游标 + 1
                    }
                }
                指 = 0
            }
            lr 全数 < 512 {
                全表[全数].尺寸 = sz
                全表[全数].个数 = 个
                全数 = 全数 + 1
            }
            lf
        }

        @ ── 函数 tt ──
        lr 是关(游标, "tt") == 1 {
            游标 = 游标 + 1
            lr 函数 < 512 {
                函表[函数].名起 = 记号表[游标].文起
                函表[函数].名长 = 记号表[游标].文长
                函表[函数].参起 = 参数
                函表[函数].参个数 = 0
                函表[函数].返回 = 4
                函表[函数].体起 = 0
                函表[函数].体止 = 0
            }
            游标 = 游标 + 1
            lr 是符(游标, "(") == 1 {
                游标 = 游标 + 1
                ll {
                    lr 记号表[游标].类 == 0 { ls }
                    lr 是符(游标, ")") == 1 { 游标 = 游标 + 1  ls }
                    lr 记号表[游标].类 == 4 {
                        参表[参数].名起 = 记号表[游标].文起
                        参表[参数].名长 = 记号表[游标].文长
                        参表[参数].尺寸 = 4
                        参表[参数].个数 = 0
                        参表[参数].构 = 99
                        参数 = 参数 + 1
                        游标 = 游标 + 1
                        lr 是符(游标, ":") == 1 {
                            游标 = 游标 + 1
                            lr 是符(游标, "*") == 1 {
                                参表[参数 - 1].尺寸 = 8
                                参表[参数 - 1].个数 = 1
                                游标 = 游标 + 1
                                lr 记号表[游标].类 == 6 { 游标 = 游标 + 1 }
                            }
                            lr 记号表[游标].类 == 6 {
                                参表[参数 - 1].尺寸 = 型尺寸(找类型(游标))
                                游标 = 游标 + 1
                            }
                            lr 记号表[游标].类 == 4 { 游标 = 游标 + 1 }
                        }
                        lf
                    }
                    游标 = 游标 + 1
                }
            }
            sz = 4                               @ ★ 先归位：没写 -> 类型 时默认 4
            lr 是符(游标, "->") == 1 {
                游标 = 游标 + 1
                lr 记号表[游标].类 == 6 { sz = 型尺寸(找类型(游标))  游标 = 游标 + 1 }
            }
            lr 函数 < 512 {
                函表[函数].参个数 = 参数 - 函表[函数].参起
                函表[函数].返回 = sz
                函数 = 函数 + 1
            }
            lr 是符(游标, "{") == 1 {
                lr 函数 > 0 { 函表[函数 - 1].体起 = 游标 + 1 }   @ ★ 计数已经 +1 了，要退一格
                跳块()
                lr 函数 > 0 { 函表[函数 - 1].体止 = 游标 - 1 }
            }
            lf
        }

        游标 = 游标 + 1
    }
    zz 0
}

@ ══════════════════════════════════════════════════════════════════
@  导出（格式和 stage0 -符号 一样）
@ ══════════════════════════════════════════════════════════════════
tt 出符号() -> u32 {
    tz i: u32 = 0
    tz j: u32 = 0
    i = 0
    ll {
        lr i >= 构数 { ls }
        印("结构体 ")
        印串(池址 + 构表[i].名起)
        印(" ")
        打无符号(构表[i].尺寸)
        印(" ")
        打无符号(构表[i].字段数)
        印("\n")
        j = 0
        ll {
            lr j >= 构表[i].字段数 { ls }
            印("字段 ")
            印串(池址 + 字表[构表[i].字起 + j].名起)
            印(" ")
            打无符号(字表[构表[i].字起 + j].尺寸)
            印("\n")
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    ll {
        lr i >= 全数 { ls }
        印("全局 ")
        印串(池址 + 全表[i].名起)
        印(" ")
        打无符号(全表[i].尺寸)
        印(" ")
        打无符号(全表[i].个数)
        印("\n")
        i = i + 1
    }
    i = 0
    ll {
        lr i >= 函数 { ls }
        印("函数 ")
        印串(池址 + 函表[i].名起)
        印(" ")
        打无符号(函表[i].参个数)
        印(" ")
        打无符号(函表[i].返回)
        印("\n")
        j = 0
        ll {
            lr j >= 函表[i].参个数 { ls }
            印("参数 ")
            印串(池址 + 参表[函表[i].参起 + j].名起)
            印(" ")
            打无符号(参表[函表[i].参起 + j].尺寸)
            印(" ")
            打无符号(参表[函表[i].参起 + j].个数)
            印("\n")
            j = j + 1
        }
        i = i + 1
    }
    zz 0
}
