@ ══════════════════════════════════════════════════════════════════
@  词法.ly —— 用六爻写的词法分析器（自举第一级的第一块）
@
@  目标：对同一份源码，吐出和 stage0「lyc -词法」一模一样的记号流。
@        两边逐字节一致，才算这块写对了。
@
@  记号类别（和 stage0 的枚举一致）：
@     0 EOF   1 NL   2 NUM   3 STR   4 ID   5 KW   6 TY   7 P
@ ══════════════════════════════════════════════════════════════════

tl 记号 { 类: u32  值: u32  行: u32  文起: u32  文长: u32 }

qj 记号表[16384]: 记号
qj 记号数: u32

qj 文本池[65536]: u32         @ 记号的文字堆在这（按字节用，每个记号末尾补 0）
qj 池顶: u32
qj 池址: u32

qj 源址: u32                  @ 源码首址（按字节用）
qj 源长: u32
qj 位: u32                    @ 扫描位置
qj 行: u32

@ ── 关键字表：13 个 KEYWORDS + 3 个运算符关键字，都算 KW ──
qj 关字[24]: u32
qj 关字数: u32

@ ── 类型表：9 个 ──
qj 型字[48]: u32
qj 型字数: u32

@ ── 源码池：源码太大，一个字符串字面量塞不下，改成【分块拼进来】 ──
qj 源池[131072]: u32
qj 源池址: u32
qj 源池顶: u32

@ ── 数字字符（打印无符号数要用）──
qj 数字符[10]: u32
qj 数缓[16]: u32

@ ══════════════════════════════════════════════════════════════════
@  小工具
@ ══════════════════════════════════════════════════════════════════

@ 把一段（NUL 结尾的）源码拼进源池
tt 拼(s: *u8) -> u32 {
    tz i: u32 = 0
    ll {
        tz c: u32 = 0
        wx { c = ^(s + i) }
        lr c == 0 { ls }
        wx { ^(源池址 + 源池顶) = c }
        源池顶 = 源池顶 + 1
        i = i + 1
    }
    zz 0
}

@ 打印一个字符（借 数字符 表）
tt 打一位(d: u32) -> u32 {
    印串(数字符[d])
    zz 0
}

@ ★ 无符号打印：印() 是有符号的，值超过 2^31 会打成负数
tt 打无符号(v: u32) -> u32 {
    tz 值: u32 = 0
    tz n: u32 = 0
    tz i: u32 = 0
    值 = v                       @ 参数不可变，拷一份
    lr 值 == 0 { 打一位(0)  zz 0 }
    ll {
        lr 值 == 0 { ls }
        数缓[n] = 值 - (值  hl  10) * 10
        值 = 值  hl  10
        n = n + 1
    }
    i = n
    ll {
        lr i == 0 { ls }
        i = i - 1
        打一位(数缓[i])
    }
    zz 0
}

@ 取源码第 i 个字节
tt 取源(i: u32) -> u32 {
    tz c: u32 = 0
    wx { c = ^(源址 + i) }
    zz c
}

@ 往文本池塞一个字节，返回它的下标
tt 塞池(c: u32) -> u32 {
    tz k: u32 = 0
    wx { ^(池址 + 池顶) = c }
    k = 池顶
    池顶 = 池顶 + 1
    zz k
}

@ 文本池取字节
tt 取池(i: u32) -> u32 {
    tz c: u32 = 0
    wx { c = ^(池址 + i) }
    zz c
}

@ 把文本池里 [起,起+长) 和 NUL 结尾的字符串比较
tt 池比串(起: u32, 长: u32, s: *u8) -> u32 {
    tz i: u32 = 0
    ll {
        tz a: u32 = 0
        tz b: u32 = 0
        wx { b = ^(s + i) }
        lr i >= 长 {
            lr b != 0 { zz 0 }
            zz 1
        }
        a = 取池(起 + i)
        lr a != b { zz 0 }
        i = i + 1
    }
    zz 0
}

@ 是标识符字符吗（字母 / 下划线 / 高位字节）
tt 是名字(c: u32) -> u32 {
    lr c >= 97 { lr c <= 122 { zz 1 } }
    lr c >= 65 { lr c <= 90 { zz 1 } }
    lr c == 95 { zz 1 }
    lr c >= 128 { zz 1 }
    zz 0
}

@ 是数字字符吗
tt 是数字(c: u32) -> u32 {
    lr c >= 48 { lr c <= 57 { zz 1 } }
    zz 0
}

@ 十六进制一位的值；不是就返回 99
tt 十六值(c: u32) -> u32 {
    lr c >= 48 { lr c <= 57 { zz c - 48 } }
    lr c >= 97 { lr c <= 102 { zz c - 87 } }
    lr c >= 65 { lr c <= 70 { zz c - 55 } }
    zz 99
}

@ ══════════════════════════════════════════════════════════════════
@  敲一个记号进表
@ ══════════════════════════════════════════════════════════════════
tt 记(类: u32, 值: u32, 文起: u32, 文长: u32) -> u32 {
    lr 记号数 >= 16384 { zz 0 }
    记号表[记号数].类 = 类
    记号表[记号数].值 = 值
    记号表[记号数].行 = 行
    记号表[记号数].文起 = 文起
    记号表[记号数].文长 = 文长
    记号数 = 记号数 + 1
    zz 0
}

@ ══════════════════════════════════════════════════════════════════
@  主循环
@ ══════════════════════════════════════════════════════════════════
tt 词法() -> u32 {
    tz c: u32 = 0
    tz 起: u32 = 0
    tz 长: u32 = 0
    tz i: u32 = 0
    tz k: u32 = 0
    tz 找到: u32 = 0
    tz d: u32 = 0
    tz v: u32 = 0
    tz 值: u32 = 0
    tz 基: u32 = 0

    关字[0] = "tt"   关字[1] = "zz"   关字[2] = "th"   关字[3] = "tz"
    关字[4] = "nn"   关字[5] = "nr"   关字[6] = "nd"   关字[7] = "ns"
    关字[8] = "nf"   关字[9] = "tn"   关字[10] = "qj"  关字[11] = "wx"
    关字[12] = "hs"  关字[13] = "hr"  关字[14] = "hd"
    关字[15] = "ht"  关字[16] = "hz"  关字[17] = "hh"
    关字[18] = "hn"  关字[19] = "hf"
    关字[20] = "st"  关字[21] = "dt"  关字[22] = "dd"
    关字[23] = "lz"  关字[24] = "lh"  关字[25] = "lt"
    关字数 = 26
    型字[0] = "u8"   型字[1] = "u16"  型字[2] = "u32"
    型字[3] = "u64"  型字[4] = "i8"   型字[5] = "i16"
    型字[6] = "i32"  型字[7] = "i64"  型字[8] = "z"
    型字[9] = "J"
    型字[10] = "M"
    型字[11] = "S"
    型字[12] = "H"
    型字[13] = "T"
    型字[14] = "JJ"
    型字[15] = "JM"
    型字[16] = "JS"
    型字[17] = "JH"
    型字[18] = "JT"
    型字[19] = "MJ"
    型字[20] = "MM"
    型字[21] = "MS"
    型字[22] = "MH"
    型字[23] = "MT"
    型字[24] = "SJ"
    型字[25] = "SM"
    型字[26] = "SS"
    型字[27] = "SH"
    型字[28] = "ST"
    型字[29] = "HJ"
    型字[30] = "HM"
    型字[31] = "HS"
    型字[32] = "HH"
    型字[33] = "HT"
    型字[34] = "TJ"
    型字[35] = "TM"
    型字[36] = "TS"
    型字[37] = "TH"
    型字[38] = "TT"
    型字数 = 39

    wx { 池址 = 地址(文本池) }
    位 = 0
    行 = 1
    记号数 = 0
    池顶 = 0

    ll {
        lr 位 >= 源长 { ls }
        c = 取源(位)

        lr c == 32 { 位 = 位 + 1  lf }
        lr c == 9  { 位 = 位 + 1  lf }
        lr c == 13 { 位 = 位 + 1  lf }

        lr c == 10 {
            位 = 位 + 1
            记(1, 0, 0, 0)
            行 = 行 + 1
            lf
        }

        @ 分号也当语句结束（和 stage0 一致；注意它不加行号）
        lr c == 59 {
            位 = 位 + 1
            记(1, 0, 0, 0)
            lf
        }

        lr c == 64 {
            ll { lr 位 >= 源长 { ls }  lr 取源(位) == 10 { ls }  位 = 位 + 1 }
            lf
        }
        lr c == 35 {
            ll { lr 位 >= 源长 { ls }  lr 取源(位) == 10 { ls }  位 = 位 + 1 }
            lf
        }

        lr c == 34 {
            位 = 位 + 1
            起 = 池顶
            长 = 0
            ll {
                lr 位 >= 源长 { ls }
                d = 取源(位)
                lr d == 34 { 位 = 位 + 1  ls }
                lr d == 92 {
                    位 = 位 + 1
                    d = 取源(位)
                    lr d == 110 { d = 10 }
                    lr d == 116 { d = 9 }
                    lr d == 48  { d = 0 }
                    lr d == 101 { d = 27 }
                    lr d == 114 { d = 13 }
                    lr d == 98  { d = 8 }
                }
                塞池(d)
                长 = 长 + 1
                位 = 位 + 1
            }
            塞池(0)
            记(3, 0, 起, 长)
            lf
        }

        lr 是数字(c) {
            基 = 10
            lr c == 48 {
                lr 取源(位 + 1) == 120 { 基 = 16  位 = 位 + 2 }
                lr 取源(位 + 1) == 88  { 基 = 16  位 = 位 + 2 }
            }
            值 = 0
            ll {
                lr 位 >= 源长 { ls }
                d = 取源(位)
                v = 十六值(d)
                lr v > 15 { ls }
                lr 基 == 10 { lr v > 9 { ls } }
                值 = 值 * 基 + v
                位 = 位 + 1
            }
            记(2, 值, 0, 0)
            lf
        }

        @ ★ rd 山地 注释：行内注释到行尾
        lr 是名字(c) {
            起 = 池顶
            长 = 0
            ll {
                lr 位 >= 源长 { ls }
                d = 取源(位)
                lr 是名字(d) { 塞池(d)  长 = 长 + 1  位 = 位 + 1  lf }
                lr 是数字(d) { 塞池(d)  长 = 长 + 1  位 = 位 + 1  lf }
                ls
            }
            塞池(0)
            lr 池比串(起, 长, "rd") == 1 {          @ rd = 行内注释，整行丢掉
                ll { lr 位 >= 源长 { ls }  lr 取源(位) == 10 { ls }  位 = 位 + 1 }
                lf
            }
            找到 = 0
            i = 0
            ll {
                lr i >= 关字数 { ls }
                lr 池比串(起, 长, 关字[i]) == 1 { 找到 = 1  ls }
                i = i + 1
            }
            lr 找到 == 1 { 记(5, 0, 起, 长)  lf }
            找到 = 0
            i = 0
            ll {
                lr i >= 型字数 { ls }
                lr 池比串(起, 长, 型字[i]) == 1 { 找到 = 1  ls }
                i = i + 1
            }
            lr 找到 == 1 { 记(6, 0, 起, 长)  lf }
            记(4, 0, 起, 长)
            lf
        }

        k = 0
        lr 位 + 1 < 源长 {
            d = 取源(位 + 1)
            lr c == 60  { lr d == 60  { k = 1 } }
            lr c == 62  { lr d == 62  { k = 1 } }
            lr c == 45  { lr d == 62  { k = 1 } }
            lr c == 61  { lr d == 61  { k = 1 } }
            lr c == 33  { lr d == 61  { k = 1 } }
            lr c == 60  { lr d == 61  { k = 1 } }
            lr c == 62  { lr d == 61  { k = 1 } }
            lr c == 38  { lr d == 38  { k = 1 } }
            lr c == 124 { lr d == 124 { k = 1 } }
        }
        lr k == 1 {
            起 = 池顶
            塞池(c)
            塞池(取源(位 + 1))
            塞池(0)
            记(7, 0, 起, 2)
            位 = 位 + 2
            lf
        }
        起 = 池顶
        塞池(c)
        塞池(0)
        记(7, 0, 起, 1)
        位 = 位 + 1
    }

    记(0, 0, 0, 0)
    zz 0
}

@ ══════════════════════════════════════════════════════════════════
@  NUL 结尾串的长度
@ ══════════════════════════════════════════════════════════════════
tt 串长(s: *u8) -> u32 {
    tz n: u32 = 0
    ll {
        tz c: u32 = 0
        wx { c = ^(s + n) }
        lr c == 0 { ls }
        n = n + 1
    }
    zz n
}

@ ══════════════════════════════════════════════════════════════════
@  导出记号流（格式和 stage0 的 -词法 一样）
@ ══════════════════════════════════════════════════════════════════
tt 打印文本(起: u32, 长: u32) -> u32 {
    @ 文本池里每个记号后面都补了 0，所以直接把指针交给 印串
    印串(池址 + 起)
    zz 0
}

tt 导出() -> u32 {
    tz i: u32 = 0
    tz 类: u32 = 0
    tz j: u32 = 0
    ll {
        lr i >= 记号数 { ls }
        类 = 记号表[i].类
        印(记号表[i].行)
        印(" ")
        lr 类 == 0 { 印("EOF ") 印("\n") }
        lr 类 == 1 { 印("NL ")  印("\n") 印("\n") }
        lr 类 == 2 { 印("NUM ") 打无符号(记号表[i].值) 印("\n") }
        lr 类 == 3 {
            j = 0
            印("STR ")
            打无符号(记号表[i].文长)
            ll {
                lr j >= 记号表[i].文长 { ls }
                印(" ")
                打无符号(取池(记号表[i].文起 + j))
                j = j + 1
            }
            印("\n")
        }
        lr 类 == 4 { 印("ID ") 打印文本(记号表[i].文起, 记号表[i].文长) 印("\n") }
        lr 类 == 5 { 印("KW ") 打印文本(记号表[i].文起, 记号表[i].文长) 印("\n") }
        lr 类 == 6 { 印("TY ") 打印文本(记号表[i].文起, 记号表[i].文长) 印("\n") }
        lr 类 == 7 { 印("P ")  打印文本(记号表[i].文起, 记号表[i].文长) 印("\n") }
        i = i + 1
    }
    zz 0
}

tt 数字符初始化() -> u32 {
    数字符[0] = "0"  数字符[1] = "1"  数字符[2] = "2"  数字符[3] = "3"
    数字符[4] = "4"  数字符[5] = "5"  数字符[6] = "6"  数字符[7] = "7"
    数字符[8] = "8"  数字符[9] = "9"
    zz 0
}

tt 装源池() -> u32 {
    wx { ^(源池址 + 源池顶) = 0 }
    源址 = 源池址
    源长 = 源池顶
    zz 0
}

tt 分析源池() -> u32 {
    装源池()
    词法()
    导出()
    zz 记号数
}

tt 只词法() -> u32 {
    装源池()
    词法()
    zz 记号数
}

tt 分析(s: *u8) -> u32 {
    源址 = 0
    wx { 源址 = s }
    源长 = 串长(s)
    词法()
    导出()
    zz 记号数
}
