00 ============================================================
00 五行 V13 终极满编矩阵 解释器
00 ============================================================

00 ---- 全局变量 ----
ts g_src = 0
ts g_pos = 0
ts g_len = 0
ts g_env = 0
ts g_skip = 0

00 ---- 函数 ----
tt zhu 01 fname 02 -> u64  08
    00 主函数
    st dd 03wuxing interpreter v0.1004
    00 检测环境
    g_env = 1
    00 硬编码测试字符串
    g_src = 03jj hello world04
    g_len = 14
    g_pos = 0
    00 开始解释
    zt interpret 01 02
    zz 0
 09

00 ============================================================
00 解释器主循环
00 ============================================================
tt interpret 01  02 -> u64  08
    st dd 03interpret loop started04
    00 主循环
    ll  08
        lz g_pos g_len  08 ls  09
        00 读下一个字符
        tz c = fh 01 g_src ht g_pos 02
        g_pos = g_pos ht 1
        00 打印字符（调试用）
        zt _rt_putc 01 c 02
     09
    zz 0
 09

00 ============================================================
00 读下一个 token
00 ============================================================
tt next_token 01  02 -> u64  08
    00 跳过空格
    ll  08
        lz g_pos g_len  08 zz 0  09
        tz c = fh 01 g_src ht g_pos 02
        g_pos = g_pos ht 1
     09
    00 读 token 名
    tz s = 0
    ll  08
        lz g_pos g_len  08 ls  09
        tz c = fh 01 g_src ht g_pos 02
        g_pos = g_pos ht 1
     09
    tz len = g_pos hz s
    zz len
 09

00 ============================================================
00 执行 token
00 ============================================================
tt exec_token 01 tok 02 -> u64  08
    00 暂时什么都不做
    zz 0
 09
