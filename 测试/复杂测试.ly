tf g_arr[16]: u64

00 ============================================================
00 函数1：加法
00 ============================================================
tt add 01 a u64 b u64 02 -> u64  08
    ht a b
    zz 0
 09

00 ============================================================
00 函数2：阶乘
00 ============================================================
tt fact 01 n u64 02 -> u64  08
    lr n <= 1  08
        zz 1
     09
    tz t = n hz 1
    tz r = zt fact 01 t 02
    ht n r
    zz 0
 09

00 ============================================================
00 函数3：斐波那契
00 ============================================================
tt fib 01 n u64 02 -> u64  08
    lr n <= 1  08
        zz n
     09
    tz a = zt fib 01 n hz 1 02
    tz b = zt fib 01 n hz 2 02
    ht a b
    zz 0
 09

00 ============================================================
00 函数4：数组求和
00 ============================================================
tt sum_arr 01 arr u64 len u64 02 -> u64  08
    tz i = 0
    tz s = 0
    ll  08
        lz i len  08 ls  09
        tz v = arr[i]
        s = ht s v
        i = ht i 1
     09
    zz s
 09

00 ============================================================
00 函数5：判断质数
00 ============================================================
tt is_prime 01 n u64 02 -> u64  08
    lr n <= 1  08
        zz 0
     09
    tz i = 2
    ll  08
        lz i ht i <= n  08 ls  09
        tz r = n hf i
        lr r == 0  08
            zz 0
         09
        i = ht i 1
     09
    zz 1
 09

00 ============================================================
00 函数6：冒泡排序
00 ============================================================
tt bubble_sort 01 arr u64 len u64 02 -> u64  08
    tz i = 0
    ll  08
        lz i len hz 1  08 ls  09
        tz j = 0
        ll  08
            lz j len hz i hz 1  08 ls  09
            tz a = arr[j]
            tz b = arr[j ht 1]
            lr a > b  08
                arr[j] = b
                arr[j ht 1] = a
             09
            j = ht j 1
         09
        i = ht i 1
     09
    zz 0
 09

